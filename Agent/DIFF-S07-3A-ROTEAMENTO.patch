+    empresaOutraId = emp2.lastID;
+
+    const adm = await run(dbHttp, `
+      INSERT INTO usuarios (username, password_hash, role, perfil, ativo, nome)
+      VALUES ('admin_r3a_http', 'hash', 'admin', 'ADMIN', 1, 'Admin')
