diff --git a/tests/cozinha/sprint07-s07-2-gestao-unidades-recurso-real.test.js b/tests/cozinha/sprint07-s07-2-gestao-unidades-recurso-real.test.js
new file mode 100644
index 0000000..97f23c9
--- /dev/null
+++ b/tests/cozinha/sprint07-s07-2-gestao-unidades-recurso-real.test.js
@@ -0,0 +1,319 @@
+/**
+ * S07-2 — ACL + recurso real de implantação para gestão de unidades.
+ * Sem monkeypatch de recursoHabilitado. Banco temporário. Sem S07-3 / sem oficial.
+ *
+ *   set CDS_BLOQUEAR_BANCO_OFICIAL=1
+ *   set CDS_TEST_ISOLATION=1
+ *   set CDS_FORCAR_LOCAL=1
+ *   node --test --test-concurrency=1 --test-force-exit tests/cozinha/sprint07-s07-2-gestao-unidades-recurso-real.test.js
+ */
+'use strict';
+
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const http = require('http');
+const express = require('express');
+const jwt = require('jsonwebtoken');
+const { describe, it, before, after } = require('node:test');
+const assert = require('node:assert/strict');
+
+const dbDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cds-cozinha-s07-2-recurso-'));
+process.env.DB_DIR = dbDir;
+process.env.CDS_TEST_ISOLATION = '1';
+process.env.CDS_BLOQUEAR_BANCO_OFICIAL = '1';
+process.env.CDS_FORCAR_LOCAL = '1';
+process.env.JWT_SECRET = process.env.JWT_SECRET || 'cds-test-jwt-s07-2-recurso-real';
+delete process.env.CDS_ALLOW_OFFICIAL_DB;
+delete process.env.CDS_COZINHA_IMPRESSAO_FISICA_AUTORIZADA;
+
+const {
+  garantirSchemaCozinha,
+  isCozinhaOperacional,
+  getCozinhaSchemaStatus
+} = require('../../backend/utils/cozinhaSchema');
+const { garantirTabelaOperadorUnidades } = require('../../backend/services/cozinha/cozinhaAuthUnidade');
+const { verificarToken } = require('../../backend/middleware/auth');
+const { exigirRecurso } = require('../../backend/middleware/validarRecursoImplantacao');
+const configService = require('../../backend/services/configuracaoService');
+
+function run(db, sql, params = []) {
+  return new Promise((resolve, reject) => {
+    db.run(sql, params, function cb(err) {
+      if (err) reject(err);
+      else resolve(this);
+    });
+  });
+}
+function get(db, sql, params = []) {
+  return new Promise((resolve, reject) => {
+    db.get(sql, params, (err, row) => (err ? reject(err) : resolve(row || null)));
+  });
+}
+
+/** Espelha o gate de cozinha-unidades após normalização trim + toUpperCase. */
+function aclCozinhaUnidades(user) {
+  const roleNorm = String(user.role || '').trim().toLowerCase();
+  const perfilNorm = String(user.perfil || '').trim().toUpperCase();
+  return roleNorm === 'admin' || perfilNorm === 'ADMIN' || perfilNorm === 'SUPER_ADMIN';
+}
+
+describe('S07-2 — ACL menu / integração recurso pedidos', () => {
+  it('menu ERP e ACL registram cozinha-unidades com normalização de perfil', () => {
+    const raiz = path.resolve(__dirname, '../..');
+    const indexHtml = fs.readFileSync(path.join(raiz, 'frontend/erp/index.html'), 'utf8');
+    const appJs = fs.readFileSync(path.join(raiz, 'frontend/erp/js/app.js'), 'utf8');
+    const acl = fs.readFileSync(path.join(raiz, 'frontend/shared/js/access-control.js'), 'utf8');
+
+    assert.match(indexHtml, /data-page="cozinha-unidades"/);
+    assert.match(indexHtml, /Gestão de Cozinhas/);
+    assert.match(indexHtml, /id="nav-cozinha-unidades"/);
+    assert.match(appJs, /'cozinha-unidades':\s*\['\/erp\/js\/cozinha-unidades\.js'\]/);
+    assert.match(appJs, /case 'cozinha-unidades'/);
+    assert.match(appJs, /loadCozinhaUnidades/);
+    assert.match(acl, /'cozinha-unidades':\s*'configuracoes'/);
+    assert.match(acl, /page === 'cozinha-unidades'/);
+    assert.match(acl, /String\(perfil \|\| ''\)\.trim\(\)\.toUpperCase\(\)/);
+    assert.match(acl, /exigirRecurso\('pedidos'\)|recurso 'pedidos'/);
+  });
+
+  it('administrador operacional autorizado passa no gate do menu', () => {
+    assert.equal(aclCozinhaUnidades({ role: 'admin', perfil: 'USUARIO' }), true);
+    assert.equal(aclCozinhaUnidades({ role: 'operador', perfil: 'ADMIN' }), true);
+    assert.equal(aclCozinhaUnidades({ role: 'operador', perfil: '  admin  ' }), true);
+    assert.equal(aclCozinhaUnidades({ role: 'operador', perfil: 'super_admin' }), true);
+    assert.equal(aclCozinhaUnidades({ role: 'ADMIN', perfil: 'USUARIO' }), true);
+  });
+
+  it('operador comum não vê o menu de gestão', () => {
+    assert.equal(aclCozinhaUnidades({ role: 'operador', perfil: 'USUARIO' }), false);
+    assert.equal(aclCozinhaUnidades({ role: 'caixa', perfil: 'CAIXA' }), false);
+  });
+});
+
+describe('S07-2 — HTTP com recursoHabilitado real (sem monkeypatch)', () => {
+  let server;
+  let baseUrl;
+  let dbHttp;
+  let empresaId;
+  let adminId;
+  let opId;
+  let tokenAdmin;
+  let tokenOp;
+  let configAntes;
+  let recursoFnOriginal;
+
+  function requestJson(method, urlPath, { token, body, empresaHeader } = {}) {
+    const u = new URL(urlPath, baseUrl);
+    const emp = empresaHeader != null ? empresaHeader : empresaId;
+    const payload = body != null ? JSON.stringify(body) : null;
+    return new Promise((resolve, reject) => {
+      const req = http.request({
+        hostname: u.hostname,
+        port: u.port,
+        path: u.pathname + u.search,
+        method,
+        headers: {
+          'Content-Type': 'application/json',
+          ...(emp != null ? { 'X-Empresa-Id': String(emp) } : {}),
+          ...(token ? { Authorization: `Bearer ${token}` } : {}),
+          ...(payload ? { 'Content-Length': Buffer.byteLength(payload) } : {})
+        }
+      }, (res) => {
+        const chunks = [];
+        res.on('data', (c) => chunks.push(c));
+        res.on('end', () => {
+          const raw = Buffer.concat(chunks).toString('utf8');
+          let json = null;
+          try { json = raw ? JSON.parse(raw) : null; } catch (_e) { json = { raw }; }
+          resolve({ status: res.statusCode, body: json });
+        });
+      });
+      req.on('error', reject);
+      if (payload) req.write(payload);
+      req.end();
+    });
+  }
+
+  before(async () => {
+    recursoFnOriginal = configService.recursoHabilitado;
+    assert.equal(typeof recursoFnOriginal, 'function');
+
+    dbHttp = require('../../backend/database');
+    await new Promise((resolve, reject) => {
+      const timer = setTimeout(() => reject(new Error('DB timeout')), 60000);
+      dbHttp.whenReady((err) => {
+        clearTimeout(timer);
+        if (err) reject(err);
+        else resolve();
+      });
+    });
+
+    for (let i = 0; i < 100; i += 1) {
+      const row = await get(dbHttp, `
+        SELECT name FROM sqlite_master WHERE type='table' AND name='cozinha_notificacoes'
+      `);
+      const st = getCozinhaSchemaStatus();
+      if (row && row.name === 'cozinha_notificacoes' && (st.operacional || st.erro)) break;
+      await new Promise((r) => setTimeout(r, 200));
+    }
+    let schemaOut = null;
+    let ultimoErro = null;
+    for (let t = 0; t < 8; t += 1) {
+      try {
+        schemaOut = await garantirSchemaCozinha(dbHttp);
+        ultimoErro = null;
+        break;
+      } catch (err) {
+        ultimoErro = err;
+        await new Promise((r) => setTimeout(r, 300));
+      }
+    }
+    if (!schemaOut || !schemaOut.operacional) {
+      throw ultimoErro || new Error('Schema Cozinha não operacional');
+    }
+    await garantirTabelaOperadorUnidades(dbHttp);
+    assert.equal(isCozinhaOperacional(), true);
+
+    configAntes = configService.readConfig();
+    // Habilita pedidos pelo mecanismo real de implantação — sem monkeypatch.
+    configService.saveConfig({
+      tipoImplantacao: 'ERP_SEM_FISCAL',
+      modoOperacao: 'LOCAL',
+      modulo_pedidos: true,
+      habilitar_expedicao: false,
+      habilitar_faturamento: false
+    });
+    assert.strictEqual(
+      configService.recursoHabilitado,
+      recursoFnOriginal,
+      'recursoHabilitado não deve ser substituído neste teste'
+    );
+    assert.equal(configService.recursoHabilitado('pedidos'), true);
+    assert.equal(configService.getRecursos().recursos.pedidos, true);
+
+    const emp = await run(dbHttp, `
+      INSERT INTO empresas (cnpj, razao_social, nome_fantasia, ativo)
+      VALUES ('88776655000144', 'Emp Recurso', 'ER', 1)
+    `);
+    empresaId = emp.lastID;
+
+    const adm = await run(dbHttp, `
+      INSERT INTO usuarios (username, password_hash, role, perfil, ativo, nome)
+      VALUES ('admin_recurso_real', 'hash', 'admin', 'ADMIN', 1, 'Admin')
+    `);
+    adminId = adm.lastID;
+    const op = await run(dbHttp, `
+      INSERT INTO usuarios (username, password_hash, role, perfil, ativo, nome)
+      VALUES ('op_recurso_real', 'hash', 'operador', 'USUARIO', 1, 'Op')
+    `);
+    opId = op.lastID;
+
+    await run(dbHttp, `
+      INSERT INTO usuario_empresas (usuario_id, empresa_id, ativo) VALUES (?, ?, 1)
+    `, [adminId, empresaId]);
+    await run(dbHttp, `
+      INSERT INTO usuario_empresas (usuario_id, empresa_id, ativo) VALUES (?, ?, 1)
+    `, [opId, empresaId]);
+
+    tokenAdmin = jwt.sign({
+      id: adminId, username: 'admin_recurso_real', role: 'admin', perfil: 'ADMIN', permissoes: []
+    }, process.env.JWT_SECRET, { expiresIn: '1h' });
+    tokenOp = jwt.sign({
+      id: opId, username: 'op_recurso_real', role: 'operador', perfil: 'USUARIO', permissoes: []
+    }, process.env.JWT_SECRET, { expiresIn: '1h' });
+
+    const cozinhaRoutes = require('../../backend/rotas/cozinha');
+    const app = express();
+    app.use(express.json());
+    // Mesma cadeia do server.js: token + exigirRecurso('pedidos') real.
+    app.use('/api/cozinha', verificarToken, exigirRecurso('pedidos'), cozinhaRoutes);
+    server = http.createServer(app);
+    await new Promise((resolve) => server.listen(0, '127.0.0.1', resolve));
+    const addr = server.address();
+    baseUrl = `http://127.0.0.1:${addr.port}`;
+  });
+
+  after(async () => {
+    assert.strictEqual(
+      configService.recursoHabilitado,
+      recursoFnOriginal,
+      'recursoHabilitado permanece a função original ao final'
+    );
+    if (configAntes) {
+      try {
+        configService.saveConfig({
+          modulo_pedidos: configAntes.modulo_pedidos,
+          habilitar_expedicao: configAntes.habilitar_expedicao,
+          habilitar_faturamento: configAntes.habilitar_faturamento,
+          tipoImplantacao: configAntes.tipoImplantacao,
+          modoOperacao: configAntes.modoOperacao
+        });
+      } catch (_e) { /* temp dir */ }
+    }
+    if (server) await new Promise((resolve) => server.close(resolve));
+  });
+
+  it('admin: GET/POST/PATCH com pedidos habilitado via saveConfig', async () => {
+    assert.equal(configService.recursoHabilitado('pedidos'), true);
+
+    const created = await requestJson('POST', '/api/cozinha/unidades', {
+      token: tokenAdmin,
+      body: { codigo: 'REAL-01', ativo: true, empresa_id: 999999 }
+    });
+    assert.equal(created.status, 201, JSON.stringify(created.body));
+    assert.equal(created.body.unidade.codigo, 'REAL-01');
+    assert.equal(created.body.unidade.empresa_id, empresaId);
+
+    const lista = await requestJson('GET', '/api/cozinha/unidades', { token: tokenAdmin });
+    assert.equal(lista.status, 200);
+    assert.ok((lista.body.unidades || []).some((u) => u.codigo === 'REAL-01'));
+
+    const id = created.body.unidade.id;
+    const patch = await requestJson('PATCH', `/api/cozinha/unidades/${id}`, {
+      token: tokenAdmin,
+      body: { ativo: false }
+    });
+    assert.equal(patch.status, 200);
+    assert.equal(patch.body.unidade.ativo, false);
+
+    const kds = await requestJson('GET', '/api/cozinha/unidades-disponiveis', { token: tokenAdmin });
+    assert.equal(kds.status, 200);
+    assert.ok(!(kds.body.unidades || []).some((u) => u.codigo === 'REAL-01'));
+  });
+
+  it('operador continua bloqueado na gestão mesmo com pedidos habilitado', async () => {
+    const g = await requestJson('GET', '/api/cozinha/unidades', { token: tokenOp });
+    assert.equal(g.status, 403);
+    assert.equal(g.body.codigo, 'ADMIN_OPERACIONAL_OBRIGATORIO');
+  });
+
+  it('com pedidos desabilitado via saveConfig → MODULO_NAO_LICENCIADO (sem monkeypatch)', async () => {
+    configService.saveConfig({ modulo_pedidos: false });
+    assert.strictEqual(configService.recursoHabilitado, recursoFnOriginal);
+    assert.equal(configService.recursoHabilitado('pedidos'), false);
+
+    const r = await requestJson('GET', '/api/cozinha/unidades', { token: tokenAdmin });
+    assert.equal(r.status, 403);
+    assert.equal(r.body.erro, 'MODULO_NAO_LICENCIADO');
+    assert.equal(r.body.modulo, 'pedidos');
+
+    const p = await requestJson('POST', '/api/cozinha/unidades', {
+      token: tokenAdmin,
+      body: { codigo: 'BLOQ-01' }
+    });
+    assert.equal(p.status, 403);
+    assert.equal(p.body.erro, 'MODULO_NAO_LICENCIADO');
+
+    // Reabilita para não contaminar asserts seguintes / after.
+    configService.saveConfig({ modulo_pedidos: true });
+    assert.equal(configService.recursoHabilitado('pedidos'), true);
+  });
+
+  it('flags de isolamento ativas e DB temporário', () => {
+    assert.equal(process.env.CDS_BLOQUEAR_BANCO_OFICIAL, '1');
+    assert.equal(process.env.CDS_TEST_ISOLATION, '1');
+    assert.equal(process.env.CDS_FORCAR_LOCAL, '1');
+    assert.ok(String(dbDir).includes('cds-cozinha-s07-2-recurso'));
+  });
+});
