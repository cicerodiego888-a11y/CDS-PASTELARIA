+       FROM pedidos WHERE id = ? AND empresa_id = ?`,
+    [id, emp],
+    db
+  );
+  if (!atual) return { skipped: true, motivo: 'PEDIDO_NAO_ENCONTRADO' };
+
+  if (
+    String(atual.cozinha_resolucao_status || '') === 'RESOLVIDO'
