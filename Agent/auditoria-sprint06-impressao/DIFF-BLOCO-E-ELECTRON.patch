diff --git a/backend/services/cozinha/cozinhaImpressaoElectronBridge.js b/backend/services/cozinha/cozinhaImpressaoElectronBridge.js
new file mode 100644
--- /dev/null
+++ b/backend/services/cozinha/cozinhaImpressaoElectronBridge.js
@@ -0,0 +1,220 @@
+/**
+ * Ponte local Electron — Sprint 06 Bloco E.
+ * Isolada da impressão comercial/fiscal. Sem HTTP/LAN.
+ *
+ * Impressão real DESLIGADA por padrão.
+ * Requer CDS_COZINHA_IMPRESSAO_FISICA_AUTORIZADA=1 + autorizarSpoolerReal=true.
+ */
+'use strict';
+
+const { erroImpressao, parsePositiveInteger } = require('./cozinhaImpressaoContratos');
+
+const IPC_CANAIS = Object.freeze({
+  LISTAR: 'cozinha-impressao:listar-impressoras',
+  IMPRIMIR: 'cozinha-impressao:imprimir'
+});
+
+function isImpressaoFisicaAutorizada(opts = {}) {
+  const envOk = String(process.env.CDS_COZINHA_IMPRESSAO_FISICA_AUTORIZADA || '') === '1';
+  const optOk = opts.autorizarSpoolerReal === true || opts.autorizar_spooler_real === true;
+  // Testes automatizados nunca habilitam impressão real.
+  if (String(process.env.CDS_TEST_ISOLATION || '') === '1') return false;
+  if (String(process.env.CDS_BLOQUEAR_BANCO_OFICIAL || '') === '1'
+    && String(process.env.CDS_COZINHA_IMPRESSAO_FISICA_AUTORIZADA || '') !== '1') {
+    return false;
+  }
+  return envOk && optOk;
+}
+
+/**
+ * IPC/payload sanitizado: não aceita empresa/unidade/snapshot persistido.
+ * Apenas dados necessários para spooler local.
+ */
+function sanitizarPayloadImpressao(raw = {}) {
+  const proibidos = [
+    'empresa_id', 'empresaId', 'unidade_id', 'unidadeId',
+    'payload_snapshot', 'snapshot', 'rodada_id', 'rodadaId',
+    'itens', 'preco', 'danfe', 'nfce', 'tef'
+  ];
+  for (const k of proibidos) {
+    if (Object.prototype.hasOwnProperty.call(raw, k)) {
+      throw erroImpressao(
+        `Campo proibido no IPC de cozinha: ${k}`,
+        400,
+        'IMPRESSAO_IPC_CAMPO_PROIBIDO',
+        { detalhes: { campo: k } }
+      );
+    }
+  }
+
+  const deviceName = String(raw.deviceName != null ? raw.deviceName : raw.device_name || '').trim();
+  if (!deviceName) {
+    throw erroImpressao('deviceName obrigatório.', 400, 'IMPRESSAO_DEVICE_OBRIGATORIO');
+  }
+
+  const texto = String(raw.texto != null ? raw.texto : raw.conteudo || '');
+  if (!texto.trim()) {
+    throw erroImpressao('texto de impressão vazio.', 400, 'IMPRESSAO_TEXTO_VAZIO');
+  }
+
+  const vias = parsePositiveInteger(raw.vias) || 1;
+  const jobId = raw.jobId != null ? parsePositiveInteger(raw.jobId)
+    : (raw.job_id != null ? parsePositiveInteger(raw.job_id) : null);
+  const larguraMm = raw.largura_mm != null ? Number(raw.largura_mm)
+    : (raw.larguraMm != null ? Number(raw.larguraMm) : null);
+  const timeoutMs = Number(raw.timeoutMs != null ? raw.timeoutMs : raw.timeout_ms);
+  const limTimeout = Number.isFinite(timeoutMs) && timeoutMs > 0 ? timeoutMs : 15000;
+
+  return Object.freeze({
+    deviceName,
+    texto,
+    vias,
+    job_id: jobId,
+    largura_mm: larguraMm === 58 || larguraMm === 80 ? larguraMm : null,
+    timeout_ms: limTimeout,
+    silent: true
+  });
+}
+
+async function listarImpressorasCozinha(adapter) {
+  if (!adapter || typeof adapter.getPrinters !== 'function') {
+    throw erroImpressao(
+      'Adapter Electron ausente para listar impressoras.',
+      500,
+      'IMPRESSAO_ELECTRON_ADAPTER_AUSENTE'
+    );
+  }
+  const lista = await adapter.getPrinters();
+  const arr = Array.isArray(lista) ? lista : [];
+  return {
+    success: true,
+    total: arr.length,
+    impressoras: arr.map((p) => ({
+      name: String(p.name || p.deviceName || ''),
+      displayName: p.displayName != null ? String(p.displayName) : String(p.name || ''),
+      isDefault: p.isDefault === true,
+      status: p.status != null ? p.status : null
+    })).filter((p) => p.name),
+    impressao_fisica: false,
+    canal: IPC_CANAIS.LISTAR
+  };
+}
+
+/**
+ * Envia texto ao spooler (ou dry-run).
+ * Listagem/validação NÃO imprime.
+ */
+async function enviarParaSpoolerCozinha(entrada = {}, opts = {}) {
+  const payload = sanitizarPayloadImpressao(entrada);
+  const adapter = opts.adapter || entrada.adapter;
+  if (!adapter || typeof adapter.print !== 'function') {
+    throw erroImpressao(
+      'Adapter Electron ausente para impressão.',
+      500,
+      'IMPRESSAO_ELECTRON_ADAPTER_AUSENTE'
+    );
+  }
+
+  // __testeForcarSpooler: apenas sob CDS_TEST_ISOLATION (mocks; nunca impressora real).
+  const autorizada = (
+    process.env.CDS_TEST_ISOLATION === '1' && opts.__testeForcarSpooler === true
+  ) || isImpressaoFisicaAutorizada(opts);
+  const printers = await listarImpressorasCozinha(adapter);
+  const existe = printers.impressoras.some((p) => p.name === payload.deviceName);
+  if (!existe) {
+    return {
+      resultado: 'FALHA',
+      spooler_job_token: null,
+      erro: `Impressora inexistente: ${payload.deviceName}`,
+      impressao_fisica: false,
+      vias_enviadas: 0,
+      dry_run: !autorizada
+    };
+  }
+
+  if (!autorizada) {
+    // Dry-run seguro: valida device + render path sem webContents.print.
+    return {
+      resultado: 'ACEITA',
+      spooler_job_token: `electron-dry:${payload.job_id || 'x'}:${payload.vias}`,
+      erro: null,
+      impressao_fisica: false,
+      vias_enviadas: payload.vias,
+      dry_run: true,
+      aviso: 'Impressão real desabilitada (requer autorização explícita do PO).'
+    };
+  }
+
+  const tokens = [];
+  try {
+    for (let i = 1; i <= payload.vias; i += 1) {
+      const printPromise = adapter.print({
+        deviceName: payload.deviceName,
+        texto: payload.texto,
+        silent: true,
+        via: i,
+        vias: payload.vias,
+        job_id: payload.job_id,
+        largura_mm: payload.largura_mm
+      });
+      const result = await Promise.race([
+        printPromise,
+        new Promise((_, reject) => {
+          setTimeout(
+            () => reject(Object.assign(new Error('Timeout no spooler Electron'), { codigo: 'TIMEOUT' })),
+            payload.timeout_ms
+          );
+        })
+      ]);
+      tokens.push(result && result.token ? String(result.token) : `electron:${payload.job_id}:${i}`);
+    }
+  } catch (err) {
+    const msg = String(err && err.message ? err.message : err);
+    if (err && (err.codigo === 'TIMEOUT' || /timeout/i.test(msg))) {
+      return {
+        resultado: 'INCERTO',
+        spooler_job_token: tokens[0] || null,
+        erro: `Timeout Electron: ${msg}`,
+        impressao_fisica: false,
+        vias_enviadas: tokens.length,
+        dry_run: false
+      };
+    }
+    if (/communica|ECONN|ENOTFOUND|IPC|canal|adapter/i.test(msg)) {
+      return {
+        resultado: 'FALHA',
+        spooler_job_token: null,
+        erro: `Falha de comunicação Electron: ${msg}`,
+        impressao_fisica: false,
+        vias_enviadas: tokens.length,
+        dry_run: false
+      };
+    }
+    // Indeterminável
+    return {
+      resultado: 'INCERTO',
+      spooler_job_token: tokens[0] || null,
+      erro: `Resultado inconclusivo Electron: ${msg}`,
+      impressao_fisica: false,
+      vias_enviadas: tokens.length,
+      dry_run: false
+    };
+  }
+
+  return {
+    resultado: 'ACEITA',
+    spooler_job_token: tokens[tokens.length - 1] || `electron:${payload.job_id}`,
+    erro: null,
+    impressao_fisica: false,
+    vias_enviadas: payload.vias,
+    dry_run: false
+  };
+}
+
+module.exports = {
+  IPC_CANAIS,
+  isImpressaoFisicaAutorizada,
+  sanitizarPayloadImpressao,
+  listarImpressorasCozinha,
+  enviarParaSpoolerCozinha
+};
diff --git a/backend/services/cozinha/cozinhaImpressaoElectronDriver.js b/backend/services/cozinha/cozinhaImpressaoElectronDriver.js
new file mode 100644
--- /dev/null
+++ b/backend/services/cozinha/cozinhaImpressaoElectronDriver.js
@@ -0,0 +1,208 @@
+/**
+ * Driver Electron — Sprint 06 Bloco E.
+ * Separado do FAKE. Impressão real off por padrão.
+ * ACEITA = spooler aceitou (dry-run ou real autorizado), nunca confirma papel.
+ */
+'use strict';
+
+const {
+  ImpressaoDriver,
+  RESULTADOS_DRIVER,
+  assertResultadoDriver
+} = require('./cozinhaImpressaoDriver');
+const { erroImpressao, normalizarVias, parsePositiveInteger } = require('./cozinhaImpressaoContratos');
+const { renderizarTexto } = require('./CozinhaImpressaoRenderer');
+const {
+  enviarParaSpoolerCozinha,
+  listarImpressorasCozinha,
+  isImpressaoFisicaAutorizada
+} = require('./cozinhaImpressaoElectronBridge');
+
+class ElectronImpressaoDriver extends ImpressaoDriver {
+  /**
+   * @param {object} [opts]
+   * @param {object} [opts.adapter] — { getPrinters, print }
+   * @param {boolean} [opts.autorizarSpoolerReal] — exige também env de autorização
+   * @param {number} [opts.timeoutMs]
+   * @param {string} [opts.deviceName] — override (senão job/estação)
+   */
+  constructor(opts = {}) {
+    super();
+    this.adapter = opts.adapter || null;
+    this.autorizarSpoolerReal = opts.autorizarSpoolerReal === true;
+    this.timeoutMs = Number(opts.timeoutMs) > 0 ? Number(opts.timeoutMs) : 15000;
+    this.deviceNameOverride = opts.deviceName != null ? String(opts.deviceName) : null;
+    this.chamadas = [];
+    this._seq = 0;
+  }
+
+  get nome() {
+    return 'ELECTRON';
+  }
+
+  /** Sempre false no contrato: ACEITA ≠ papel impresso. */
+  get impressaoFisica() {
+    return false;
+  }
+
+  get spoolerRealHabilitado() {
+    return isImpressaoFisicaAutorizada({ autorizarSpoolerReal: this.autorizarSpoolerReal });
+  }
+
+  async listarImpressoras() {
+    return listarImpressorasCozinha(this.adapter);
+  }
+
+  resolverDeviceName(contexto = {}) {
+    if (this.deviceNameOverride) return this.deviceNameOverride;
+    if (contexto.deviceName) return String(contexto.deviceName);
+    if (contexto.device_name) return String(contexto.device_name);
+    const job = contexto.job || {};
+    if (job.device_name) return String(job.device_name);
+    if (contexto.estacao && contexto.estacao.device_name) {
+      return String(contexto.estacao.device_name);
+    }
+    return '';
+  }
+
+  async imprimir(contexto = {}) {
+    this._seq += 1;
+    const job = contexto.job || {};
+    const deviceName = this.resolverDeviceName(contexto);
+    const vias = normalizarVias(job.vias != null ? job.vias : 1);
+    const snapshotRaw = job.payload_snapshot != null
+      ? job.payload_snapshot
+      : (job.snapshot || contexto.snapshot);
+
+    if (!snapshotRaw) {
+      return assertResultadoDriver({
+        resultado: RESULTADOS_DRIVER.FALHA,
+        erro: 'ELECTRON: snapshot ausente no job',
+        impressao_fisica: false,
+        driver: 'ELECTRON'
+      });
+    }
+
+    // Snapshot imutável: renderiza cópia; nunca altera job.payload_snapshot.
+    const render = renderizarTexto(snapshotRaw, {
+      largura_mm: job.largura_mm
+        || (job.snapshot && job.snapshot.largura_mm)
+        || (typeof snapshotRaw === 'object' ? snapshotRaw.largura_mm : undefined)
+    });
+
+    this.chamadas.push({
+      seq: this._seq,
+      job_id: job.id,
+      deviceName,
+      vias,
+      largura_mm: render.largura_mm,
+      dry_run: !this.spoolerRealHabilitado,
+      em: new Date().toISOString()
+    });
+
+    if (!deviceName) {
+      return assertResultadoDriver({
+        resultado: RESULTADOS_DRIVER.FALHA,
+        erro: 'ELECTRON: device_name da estação não configurado',
+        impressao_fisica: false,
+        driver: 'ELECTRON'
+      });
+    }
+
+    if (!this.adapter) {
+      return assertResultadoDriver({
+        resultado: RESULTADOS_DRIVER.FALHA,
+        erro: 'ELECTRON: adapter IPC ausente',
+        impressao_fisica: false,
+        driver: 'ELECTRON'
+      });
+    }
+
+    let out;
+    try {
+      out = await enviarParaSpoolerCozinha({
+        deviceName,
+        texto: render.texto,
+        vias,
+        job_id: parsePositiveInteger(job.id),
+        largura_mm: render.largura_mm,
+        timeout_ms: this.timeoutMs
+      }, {
+        adapter: this.adapter,
+        autorizarSpoolerReal: this.autorizarSpoolerReal
+      });
+    } catch (err) {
+      const msg = String(err && err.message ? err.message : err);
+      if (err && err.codigo === 'IMPRESSAO_IPC_CAMPO_PROIBIDO') {
+        return assertResultadoDriver({
+          resultado: RESULTADOS_DRIVER.FALHA,
+          erro: msg,
+          impressao_fisica: false,
+          driver: 'ELECTRON'
+        });
+      }
+      return assertResultadoDriver({
+        resultado: RESULTADOS_DRIVER.INCERTO,
+        erro: `ELECTRON: ${msg}`,
+        impressao_fisica: false,
+        driver: 'ELECTRON'
+      });
+    }
+
+    return assertResultadoDriver({
+      resultado: out.resultado,
+      spooler_job_token: out.spooler_job_token,
+      erro: out.erro,
+      impressao_fisica: false,
+      driver: 'ELECTRON'
+    });
+  }
+}
+
+function criarElectronDriver(opts = {}) {
+  return new ElectronImpressaoDriver(opts);
+}
+
+/**
+ * Adapter mock para testes — nunca imprime fisicamente.
+ */
+function criarAdapterElectronMock(opts = {}) {
+  const printers = Array.isArray(opts.printers) ? opts.printers : [
+    { name: 'Cozinha-Termica-80', isDefault: true, status: 0 }
+  ];
+  const modo = String(opts.modo || 'sucesso').toLowerCase();
+  const delayMs = Number(opts.delayMs) > 0 ? Number(opts.delayMs) : 0;
+  const prints = [];
+
+  return {
+    printers,
+    prints,
+    async getPrinters() {
+      return printers.map((p) => ({ ...p }));
+    },
+    async print(payload) {
+      prints.push({ ...payload, em: new Date().toISOString() });
+      if (delayMs) await new Promise((r) => setTimeout(r, delayMs));
+      if (modo === 'timeout') {
+        await new Promise((r) => setTimeout(r, (opts.timeoutSimMs || 30)));
+        const err = new Error('mock timeout');
+        err.codigo = 'TIMEOUT';
+        throw err;
+      }
+      if (modo === 'falha-comunicacao') {
+        throw new Error('IPC canal indisponível');
+      }
+      if (modo === 'falha') {
+        throw new Error('spooler recusou (mock)');
+      }
+      return { token: `mock-spool:${payload.deviceName}:${prints.length}` };
+    }
+  };
+}
+
+module.exports = {
+  ElectronImpressaoDriver,
+  criarElectronDriver,
+  criarAdapterElectronMock,
+  erroImpressao
+};
diff --git a/electron-cozinha-impressao.js b/electron-cozinha-impressao.js
new file mode 100644
--- /dev/null
+++ b/electron-cozinha-impressao.js
@@ -0,0 +1,158 @@
+/**
+ * IPC Electron — impressão de COZINHA (Sprint 06 Bloco E).
+ * Isolado de cupom/DANFE/TEF. Não reutiliza handlers comerciais.
+ *
+ * Impressão real só com CDS_COZINHA_IMPRESSAO_FISICA_AUTORIZADA=1.
+ * Consulta de impressoras nunca inicia print.
+ */
+'use strict';
+
+const { BrowserWindow } = require('electron');
+const {
+  IPC_CANAIS,
+  isImpressaoFisicaAutorizada,
+  sanitizarPayloadImpressao
+} = require('./backend/services/cozinha/cozinhaImpressaoElectronBridge');
+
+function criarAdapterNativo(event) {
+  return {
+    async getPrinters() {
+      const win = BrowserWindow.fromWebContents(event.sender);
+      if (!win || !win.webContents) return [];
+      const lista = await win.webContents.getPrintersAsync();
+      return (lista || []).map((imp) => ({
+        name: imp.name,
+        displayName: imp.displayName || imp.name,
+        description: imp.description,
+        status: imp.status,
+        isDefault: imp.isDefault === true
+      }));
+    },
+    async print({ deviceName, texto, silent }) {
+      const win = new BrowserWindow({
+        show: false,
+        webPreferences: {
+          nodeIntegration: false,
+          contextIsolation: true
+        }
+      });
+      const html = `<!doctype html><html><head><meta charset="utf-8">
+<style>
+  @page { margin: 0; }
+  body { margin: 0; font-family: monospace; white-space: pre-wrap; font-size: 12px; }
+</style></head><body>${String(texto)
+  .replace(/&/g, '&amp;')
+  .replace(/</g, '&lt;')
+  .replace(/>/g, '&gt;')}</body></html>`;
+
+      await win.loadURL(`data:text/html;charset=utf-8,${encodeURIComponent(html)}`);
+      await new Promise((resolve, reject) => {
+        win.webContents.print(
+          { silent: silent !== false, deviceName: deviceName || undefined, printBackground: false },
+          (success, failureReason) => {
+            try { win.destroy(); } catch (_e) { /* ignore */ }
+            if (!success) {
+              reject(new Error(failureReason || 'webContents.print falhou'));
+              return;
+            }
+            resolve({ token: `electron-spool:${deviceName}:${Date.now()}` });
+          }
+        );
+      });
+      return { token: `electron-spool:${deviceName}:${Date.now()}` };
+    }
+  };
+}
+
+/**
+ * @param {import('electron').IpcMain} ipcMain
+ */
+function registrarCozinhaImpressaoHandlers(ipcMain) {
+  if (!ipcMain || typeof ipcMain.handle !== 'function') return;
+
+  try { ipcMain.removeHandler(IPC_CANAIS.LISTAR); } catch (_e) { /* ignore */ }
+  try { ipcMain.removeHandler(IPC_CANAIS.IMPRIMIR); } catch (_e) { /* ignore */ }
+
+  ipcMain.handle(IPC_CANAIS.LISTAR, async (event) => {
+    const adapter = criarAdapterNativo(event);
+    const lista = await adapter.getPrinters();
+    return {
+      success: true,
+      total: lista.length,
+      impressoras: lista,
+      impressao_fisica: false,
+      canal: IPC_CANAIS.LISTAR
+    };
+  });
+
+  ipcMain.handle(IPC_CANAIS.IMPRIMIR, async (event, rawPayload = {}) => {
+    // Rejeita tentativa de alterar empresa/unidade/snapshot via IPC.
+    const payload = sanitizarPayloadImpressao(rawPayload || {});
+    if (!isImpressaoFisicaAutorizada({
+      autorizarSpoolerReal: rawPayload && rawPayload.autorizarSpoolerReal === true
+    })) {
+      return {
+        success: false,
+        resultado: 'FALHA',
+        codigo: 'IMPRESSAO_FISICA_NAO_AUTORIZADA',
+        erro: 'Impressão física de cozinha desabilitada. Requer autorização do PO.',
+        impressao_fisica: false,
+        dry_run: true
+      };
+    }
+
+    const adapter = criarAdapterNativo(event);
+    const printers = await adapter.getPrinters();
+    if (!printers.some((p) => p.name === payload.deviceName)) {
+      return {
+        success: false,
+        resultado: 'FALHA',
+        codigo: 'IMPRESSAO_DEVICE_INEXISTENTE',
+        erro: `Impressora inexistente: ${payload.deviceName}`,
+        impressao_fisica: false
+      };
+    }
+
+    try {
+      const tokens = [];
+      for (let i = 1; i <= payload.vias; i += 1) {
+        const r = await adapter.print({
+          deviceName: payload.deviceName,
+          texto: payload.texto,
+          silent: true,
+          via: i
+        });
+        tokens.push(r && r.token ? r.token : `electron:${i}`);
+      }
+      return {
+        success: true,
+        resultado: 'ACEITA',
+        spooler_job_token: tokens[tokens.length - 1],
+        vias_enviadas: payload.vias,
+        impressao_fisica: false,
+        dry_run: false
+      };
+    } catch (err) {
+      const msg = String(err && err.message ? err.message : err);
+      if (/timeout/i.test(msg)) {
+        return {
+          success: false,
+          resultado: 'INCERTO',
+          erro: msg,
+          impressao_fisica: false
+        };
+      }
+      return {
+        success: false,
+        resultado: 'FALHA',
+        erro: msg,
+        impressao_fisica: false
+      };
+    }
+  });
+}
+
+module.exports = {
+  registrarCozinhaImpressaoHandlers,
+  IPC_CANAIS
+};
diff --git a/tests/cozinha/sprint06-bloco-e-electron-integracao.test.js b/tests/cozinha/sprint06-bloco-e-electron-integracao.test.js
new file mode 100644
--- /dev/null
+++ b/tests/cozinha/sprint06-bloco-e-electron-integracao.test.js
@@ -0,0 +1,468 @@
+/**
+ * Sprint 06 — Bloco E: integração Electron (mocks), IPC isolado, sem print físico real.
+ *
+ *   node --test --test-concurrency=1 tests/cozinha/sprint06-bloco-e-electron-integracao.test.js
+ */
+'use strict';
+
+const fs = require('fs');
+const os = require('os');
+const path = require('path');
+const { describe, it, beforeEach } = require('node:test');
+const assert = require('node:assert/strict');
+const sqlite3 = require('sqlite3').verbose();
+
+const dbDir = fs.mkdtempSync(path.join(os.tmpdir(), 'cds-cozinha-s06e-'));
+process.env.DB_DIR = dbDir;
+process.env.CDS_TEST_ISOLATION = '1';
+process.env.CDS_BLOQUEAR_BANCO_OFICIAL = '1';
+process.env.CDS_FORCAR_LOCAL = '1';
+delete process.env.CDS_COZINHA_IMPRESSAO_FISICA_AUTORIZADA;
+delete process.env.CDS_ALLOW_OFFICIAL_DB;
