diff --git a/backend/services/cozinha/cozinhaImpressaoDriver.js b/backend/services/cozinha/cozinhaImpressaoDriver.js
new file mode 100644
--- /dev/null
+++ b/backend/services/cozinha/cozinhaImpressaoDriver.js
@@ -0,0 +1,190 @@
+/**
+ * Contrato abstrato de driver de impressão — Sprint 06 Bloco D.
+ * Sem integração desktop, sem chamada de impressão nativa, sem impressora real.
+ */
+'use strict';
+
+const { erroImpressao } = require('./cozinhaImpressaoContratos');
+
+const RESULTADOS_DRIVER = Object.freeze({
+  ACEITA: 'ACEITA',
+  FALHA: 'FALHA',
+  INCERTO: 'INCERTO'
+});
+
+/**
+ * @typedef {object} DriverImpressaoResultado
+ * @property {'ACEITA'|'FALHA'|'INCERTO'} resultado
+ * @property {string|null} [spooler_job_token]
+ * @property {string|null} [erro]
+ * @property {boolean} impressao_fisica
+ * @property {string} driver
+ */
+
+function assertResultadoDriver(out) {
+  if (!out || typeof out !== 'object') {
+    throw erroImpressao('Driver retornou resultado inválido.', 500, 'IMPRESSAO_DRIVER_INVALIDO');
+  }
+  if (out.impressao_fisica === true) {
+    throw erroImpressao(
+      'Driver não pode marcar impressao_fisica=true no Bloco D.',
+      500,
+      'IMPRESSAO_FISICA_PROIBIDA'
+    );
+  }
+  const r = String(out.resultado || '').toUpperCase();
+  if (!RESULTADOS_DRIVER[r]) {
+    throw erroImpressao(
+      'resultado do driver inválido.',
+      500,
+      'IMPRESSAO_DRIVER_RESULTADO_INVALIDO',
+      { detalhes: { resultado: out.resultado } }
+    );
+  }
+  return {
+    resultado: r,
+    spooler_job_token: out.spooler_job_token != null ? String(out.spooler_job_token) : null,
+    erro: out.erro != null ? String(out.erro) : null,
+    impressao_fisica: false,
+    driver: String(out.driver || 'DESCONHECIDO')
+  };
+}
+
+/**
+ * Interface documental — qualquer driver deve expor imprimir(contexto).
+ * @interface
+ */
+class ImpressaoDriver {
+  /**
+   * @param {object} _contexto
+   * @returns {Promise<DriverImpressaoResultado>}
+   */
+  async imprimir(_contexto) {
+    throw erroImpressao(
+      'Driver abstrato: implementar imprimir().',
+      501,
+      'IMPRESSAO_DRIVER_NAO_IMPLEMENTADO'
+    );
+  }
+
+  get nome() {
+    return 'ABSTRACT';
+  }
+
+  get impressaoFisica() {
+    return false;
+  }
+}
+
+/**
+ * Driver FAKE — simula sucesso, falha conhecida ou resultado incerto.
+ * Nunca acessa impressora real nem runtime desktop de impressão.
+ */
+class FakeImpressaoDriver extends ImpressaoDriver {
+  /**
+   * @param {object} [opts]
+   * @param {'sucesso'|'falha'|'incerto'|'timeout'} [opts.modo]
+   * @param {string} [opts.erro]
+   * @param {string} [opts.tokenPrefix]
+   * @param {number} [opts.delayMs] — apenas simulação (não imprime)
+   * @param {function} [opts.resolver] — override por job: (ctx) => modo|resultado
+   */
+  constructor(opts = {}) {
+    super();
+    this.modo = String(opts.modo || 'sucesso').toLowerCase();
+    this.erroPadrao = opts.erro != null ? String(opts.erro) : null;
+    this.tokenPrefix = opts.tokenPrefix != null ? String(opts.tokenPrefix) : 'fake-spool';
+    this.delayMs = Number(opts.delayMs) > 0 ? Number(opts.delayMs) : 0;
+    this.resolver = typeof opts.resolver === 'function' ? opts.resolver : null;
+    this.chamadas = [];
+    this._seq = 0;
+  }
+
+  get nome() {
+    return 'FAKE';
+  }
+
+  get impressaoFisica() {
+    return false;
+  }
+
+  /**
+   * Altera o modo em runtime (testes / simulação operacional).
+   * @param {'sucesso'|'falha'|'incerto'|'timeout'} modo
+   */
+  setModo(modo) {
+    this.modo = String(modo || 'sucesso').toLowerCase();
+  }
+
+  async imprimir(contexto = {}) {
+    this._seq += 1;
+    const registro = {
+      seq: this._seq,
+      job_id: contexto.job && contexto.job.id,
+      vias: contexto.job && contexto.job.vias,
+      em: new Date().toISOString()
+    };
+    this.chamadas.push(registro);
+
+    if (this.delayMs > 0) {
+      await new Promise((r) => setTimeout(r, this.delayMs));
+    }
+
+    let modo = this.modo;
+    if (this.resolver) {
+      const decidido = this.resolver(contexto, registro);
+      if (decidido && typeof decidido === 'object' && decidido.resultado) {
+        return assertResultadoDriver({
+          ...decidido,
+          impressao_fisica: false,
+          driver: 'FAKE'
+        });
+      }
+      if (typeof decidido === 'string') modo = decidido.toLowerCase();
+    }
+
+    if (modo === 'falha' || modo === 'fail' || modo === 'erro') {
+      return assertResultadoDriver({
+        resultado: RESULTADOS_DRIVER.FALHA,
+        spooler_job_token: null,
+        erro: this.erroPadrao || 'FAKE: falha conhecida antes da aceitação do spooler',
+        impressao_fisica: false,
+        driver: 'FAKE'
+      });
+    }
+
+    if (modo === 'incerto' || modo === 'timeout' || modo === 'uncertain') {
+      return assertResultadoDriver({
+        resultado: RESULTADOS_DRIVER.INCERTO,
+        spooler_job_token: null,
+        erro: this.erroPadrao
+          || (modo === 'timeout'
+            ? 'FAKE: timeout — resultado indeterminável'
+            : 'FAKE: resultado incerto'),
+        impressao_fisica: false,
+        driver: 'FAKE'
+      });
+    }
+
+    // sucesso
+    return assertResultadoDriver({
+      resultado: RESULTADOS_DRIVER.ACEITA,
+      spooler_job_token: `${this.tokenPrefix}:${contexto.job && contexto.job.id}:${this._seq}`,
+      erro: null,
+      impressao_fisica: false,
+      driver: 'FAKE'
+    });
+  }
+}
+
+function criarFakeDriver(opts = {}) {
+  return new FakeImpressaoDriver(opts);
+}
+
+module.exports = {
+  RESULTADOS_DRIVER,
+  ImpressaoDriver,
+  FakeImpressaoDriver,
+  criarFakeDriver,
+  assertResultadoDriver
+};
diff --git a/backend/services/cozinha/CozinhaImpressaoWorkerService.js b/backend/services/cozinha/CozinhaImpressaoWorkerService.js
new file mode 100644
--- /dev/null
+++ b/backend/services/cozinha/CozinhaImpressaoWorkerService.js
@@ -0,0 +1,463 @@
+/**
+ * Worker de impressão — Sprint 06 Bloco D.
+ * Claim atômico, FAKE driver, falhas / RESULTADO_INCERTO, sem print físico / Electron / Bloco E.
+ *
+ * Política conservadora: dúvida → RESULTADO_INCERTO; sem reenvio automático.
+ * PROCESSANDO abandonado NÃO volta para PENDENTE.
+ */
+'use strict';
+
+const {
+  erroImpressao,
+  parsePositiveInteger,
+  ESTADOS_FILA
+} = require('./cozinhaImpressaoContratos');
+const { exigirUnidadeOperacional } = require('./cozinhaUnidadeOperacional');
+const { RESULTADOS_DRIVER, assertResultadoDriver, criarFakeDriver } = require('./cozinhaImpressaoDriver');
+const FilaService = require('./CozinhaImpressaoFilaService');
+
+const ABANDONO_PADRAO_MS = 60 * 1000;
+
+function dbAll(db, sql, params = []) {
+  return new Promise((resolve, reject) => {
+    db.all(sql, params, (err, rows) => (err ? reject(err) : resolve(rows || [])));
+  });
+}
+
+function dbGet(db, sql, params = []) {
+  return new Promise((resolve, reject) => {
+    db.get(sql, params, (err, row) => (err ? reject(err) : resolve(row || null)));
+  });
+}
+
+function dbRun(db, sql, params = []) {
+  return new Promise((resolve, reject) => {
+    db.run(sql, params, function cb(err) {
+      if (err) reject(err);
+      else resolve(this);
+    });
+  });
+}
+
+function agoraIso() {
+  return new Date().toISOString();
+}
+
+function exigirEmpresa(empresaId) {
+  const id = parsePositiveInteger(empresaId);
+  if (!id) {
+    throw erroImpressao('empresa_id obrigatório.', 400, 'EMPRESA_OBRIGATORIA');
+  }
+  return id;
+}
+
+function normalizarWorkerId(raw) {
+  const id = String(raw == null ? '' : raw).trim();
+  if (!id) {
+    throw erroImpressao('worker_id obrigatório.', 400, 'IMPRESSAO_WORKER_ID_OBRIGATORIO');
+  }
+  if (id.length > 128) {
+    throw erroImpressao('worker_id excede o tamanho máximo.', 400, 'IMPRESSAO_WORKER_ID_INVALIDO');
+  }
+  return id;
+}
+
+function estadoFinalDeResultadoDriver(resultado) {
+  if (resultado === RESULTADOS_DRIVER.ACEITA) return ESTADOS_FILA.ACEITA_PELO_SPOOLER;
+  if (resultado === RESULTADOS_DRIVER.FALHA) return ESTADOS_FILA.FALHA;
+  return ESTADOS_FILA.RESULTADO_INCERTO;
+}
+
+/**
+ * Claim atômico PENDENTE → PROCESSANDO (BEGIN IMMEDIATE).
+ * Dois workers concorrentes: no máximo um obtém changes=1.
+ */
+async function reivindicarProximoJob(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  const workerId = normalizarWorkerId(
+    entrada.workerId != null ? entrada.workerId : entrada.worker_id
+  );
+  const estacaoId = parsePositiveInteger(
+    entrada.estacaoImpressaoId != null
+      ? entrada.estacaoImpressaoId
+      : (entrada.estacao_impressao_id != null ? entrada.estacao_impressao_id : entrada.estacaoId)
+  );
+
+  // Claim atômico em uma única UPDATE (SQLite serializa o statement).
+  // WHERE estado='PENDENTE' impede segundo worker de reivindicar o mesmo id.
+  const agora = agoraIso();
+  const filtroEstacao = estacaoId
+    ? 'AND estacao_impressao_id = ?'
+    : '';
+  const paramsCand = estacaoId
+    ? [empresaId, unidadeId, ESTADOS_FILA.PENDENTE, estacaoId]
+    : [empresaId, unidadeId, ESTADOS_FILA.PENDENTE];
+
+  const upd = await dbRun(db, `
+    UPDATE cozinha_impressao_fila
+    SET estado = ?,
+        worker_id = ?,
+        processando_em = ?,
+        tentativas = tentativas + 1,
+        updated_at = ?,
+        ultimo_erro = NULL
+    WHERE id = (
+      SELECT id FROM (
+        SELECT id
+        FROM cozinha_impressao_fila
+        WHERE empresa_id = ?
+          AND unidade_id = ?
+          AND estado = ?
+          AND tentativas < max_tentativas
+          ${filtroEstacao}
+        ORDER BY created_at ASC, id ASC
+        LIMIT 1
+      )
+    )
+    AND estado = ?
+  `, [
+    ESTADOS_FILA.PROCESSANDO,
+    workerId,
+    agora,
+    agora,
+    ...paramsCand,
+    ESTADOS_FILA.PENDENTE
+  ]);
+
+  if (!upd || upd.changes !== 1) {
+    return { success: true, reivindicado: false, job: null, impressao_fisica: false };
+  }
+
+  const row = await dbGet(db, `
+    SELECT * FROM cozinha_impressao_fila
+    WHERE empresa_id = ?
+      AND unidade_id = ?
+      AND worker_id = ?
+      AND estado = ?
+      AND processando_em = ?
+    ORDER BY id DESC
+    LIMIT 1
+  `, [empresaId, unidadeId, workerId, ESTADOS_FILA.PROCESSANDO, agora]);
+
+  if (!row) {
+    return { success: true, reivindicado: false, job: null, impressao_fisica: false };
+  }
+
+  return {
+    success: true,
+    reivindicado: true,
+    job: FilaService.mapearJob(row, { incluirSnapshot: true }),
+    impressao_fisica: false
+  };
+}
+
+/**
+ * Jobs PROCESSANDO abandonados → RESULTADO_INCERTO (nunca voltam a PENDENTE).
+ */
+async function recuperarJobsAbandonados(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  const rawLim = entrada.limiteMs != null ? entrada.limiteMs : entrada.abandono_ms;
+  const limiteMs = Number(rawLim);
+  // limiteMs === 0 → todos PROCESSANDO (ex.: reinício do worker); omitido → padrão.
+  const lim = rawLim == null || rawLim === ''
+    ? ABANDONO_PADRAO_MS
+    : (Number.isFinite(limiteMs) && limiteMs >= 0 ? limiteMs : ABANDONO_PADRAO_MS);
+  const agora = Date.now();
+  const limiteIso = new Date(agora - lim).toISOString();
+
+  const rows = await dbAll(db, `
+    SELECT id, processando_em, worker_id
+    FROM cozinha_impressao_fila
+    WHERE empresa_id = ?
+      AND unidade_id = ?
+      AND estado = ?
+      AND (
+        processando_em IS NULL
+        OR processando_em <= ?
+      )
+  `, [empresaId, unidadeId, ESTADOS_FILA.PROCESSANDO, limiteIso]);
+
+  const marcados = [];
+  for (const row of rows) {
+    const agoraUpd = agoraIso();
+    const msg = `Worker abandonado/timeout — resultado indeterminável (worker_id=${row.worker_id || '?'})`;
+    const upd = await dbRun(db, `
+      UPDATE cozinha_impressao_fila
+      SET estado = ?,
+          ultimo_erro = ?,
+          updated_at = ?
+      WHERE id = ?
+        AND empresa_id = ?
+        AND unidade_id = ?
+        AND estado = ?
+    `, [
+      ESTADOS_FILA.RESULTADO_INCERTO,
+      msg,
+      agoraUpd,
+      row.id,
+      empresaId,
+      unidadeId,
+      ESTADOS_FILA.PROCESSANDO
+    ]);
+    if (upd && upd.changes === 1) {
+      marcados.push(row.id);
+    }
+  }
+
+  return {
+    success: true,
+    recuperados: marcados.length,
+    job_ids: marcados,
+    novo_estado: ESTADOS_FILA.RESULTADO_INCERTO,
+    impressao_fisica: false
+  };
+}
+
+/**
+ * Aplica resultado do driver apenas se o job ainda está PROCESSANDO pelo mesmo worker.
+ */
+async function registrarResultado(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  const jobId = parsePositiveInteger(entrada.jobId != null ? entrada.jobId : entrada.id);
+  const workerId = normalizarWorkerId(
+    entrada.workerId != null ? entrada.workerId : entrada.worker_id
+  );
+  if (!jobId) {
+    throw erroImpressao('job id obrigatório.', 400, 'IMPRESSAO_JOB_ID_OBRIGATORIO');
+  }
+
+  const driverOut = assertResultadoDriver({
+    resultado: entrada.resultado,
+    spooler_job_token: entrada.spooler_job_token != null
+      ? entrada.spooler_job_token
+      : entrada.spoolerJobToken,
+    erro: entrada.erro != null ? entrada.erro : entrada.ultimo_erro,
+    impressao_fisica: false,
+    driver: entrada.driver || 'FAKE'
+  });
+
+  const estadoFinal = estadoFinalDeResultadoDriver(driverOut.resultado);
+  const agora = agoraIso();
+
+  const upd = await dbRun(db, `
+    UPDATE cozinha_impressao_fila
+    SET estado = ?,
+        spooler_job_token = CASE
+          WHEN ? IS NOT NULL THEN ?
+          ELSE spooler_job_token
+        END,
+        ultimo_erro = ?,
+        updated_at = ?
+    WHERE id = ?
+      AND empresa_id = ?
+      AND unidade_id = ?
+      AND estado = ?
+      AND worker_id = ?
+  `, [
+    estadoFinal,
+    driverOut.spooler_job_token,
+    driverOut.spooler_job_token,
+    driverOut.erro,
+    agora,
+    jobId,
+    empresaId,
+    unidadeId,
+    ESTADOS_FILA.PROCESSANDO,
+    workerId
+  ]);
+
+  if (!upd || upd.changes !== 1) {
+    throw erroImpressao(
+      'Job não está PROCESSANDO por este worker (claim perdido ou já finalizado).',
+      409,
+      'IMPRESSAO_RESULTADO_RECUSADO',
+      { detalhes: { job_id: jobId, worker_id: workerId } }
+    );
+  }
+
+  const out = await FilaService.obterJob({
+    db, empresaId, unidadeId, id: jobId
+  }, { db, incluirSnapshot: true });
+
+  return {
+    success: true,
+    job: out.job,
+    resultado_driver: driverOut.resultado,
+    impressao_fisica: false
+  };
+}
+
+/**
+ * Processa um job já reivindicado com o driver (FAKE por padrão).
+ */
+async function processarJobReivindicado(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  const workerId = normalizarWorkerId(
+    entrada.workerId != null ? entrada.workerId : entrada.worker_id
+  );
+  const job = entrada.job;
+  if (!job || !job.id) {
+    throw erroImpressao('job reivindicado obrigatório.', 400, 'IMPRESSAO_JOB_OBRIGATORIO');
+  }
+
+  const driver = opts.driver || entrada.driver || criarFakeDriver({ modo: 'sucesso' });
+  if (driver.impressaoFisica === true) {
+    throw erroImpressao(
+      'Driver com impressão física é proibido no Bloco D.',
+      500,
+      'IMPRESSAO_FISICA_PROIBIDA'
+    );
+  }
+
+  let driverOut;
+  try {
+    const raw = await driver.imprimir({
+      job,
+      empresaId,
+      unidadeId,
+      workerId,
+      impressao_fisica: false
+    });
+    driverOut = assertResultadoDriver({
+      ...raw,
+      impressao_fisica: false,
+      driver: raw.driver || driver.nome || 'FAKE'
+    });
+  } catch (err) {
+    // Exceção não determinável → RESULTADO_INCERTO (conservador; não reenvia).
+    driverOut = assertResultadoDriver({
+      resultado: RESULTADOS_DRIVER.INCERTO,
+      spooler_job_token: null,
+      erro: `Exceção no driver: ${err && err.message ? err.message : String(err)}`,
+      impressao_fisica: false,
+      driver: (driver && driver.nome) || 'FAKE'
+    });
+  }
+
+  return registrarResultado({
+    db,
+    empresaId,
+    unidadeId,
+    jobId: job.id,
+    workerId,
+    resultado: driverOut.resultado,
+    spooler_job_token: driverOut.spooler_job_token,
+    erro: driverOut.erro,
+    driver: driverOut.driver
+  }, { db });
+}
+
+/**
+ * Ciclo: recuperação de abandonados + claim + processar um job.
+ * Não reenvia RESULTADO_INCERTO nem ACEITA automaticamente.
+ */
+async function processarProximo(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  const workerId = normalizarWorkerId(
+    entrada.workerId != null ? entrada.workerId : entrada.worker_id
+  );
+
+  const recuperacao = await recuperarJobsAbandonados({
+    db,
+    empresaId,
+    unidadeId,
+    limiteMs: entrada.limiteMs != null ? entrada.limiteMs : entrada.abandono_ms
+  }, { db });
+
+  const claim = await reivindicarProximoJob({
+    db,
+    empresaId,
+    unidadeId,
+    workerId,
+    estacaoImpressaoId: entrada.estacaoImpressaoId != null
+      ? entrada.estacaoImpressaoId
+      : entrada.estacao_impressao_id
+  }, { db });
+
+  if (!claim.reivindicado || !claim.job) {
+    return {
+      success: true,
+      processado: false,
+      recuperacao,
+      job: null,
+      impressao_fisica: false
+    };
+  }
+
+  const resultado = await processarJobReivindicado({
+    db,
+    empresaId,
+    unidadeId,
+    workerId,
+    job: claim.job
+  }, { db, driver: opts.driver || entrada.driver });
+
+  return {
+    success: true,
+    processado: true,
+    recuperacao,
+    job: resultado.job,
+    resultado_driver: resultado.resultado_driver,
+    impressao_fisica: false
+  };
+}
+
+/**
+ * Ao iniciar/reiniciar o worker: apenas marca abandonados como INCERTO.
+ * Nunca devolve PROCESSANDO → PENDENTE.
+ */
+async function aoIniciarWorker(entrada = {}, opts = {}) {
+  const out = await recuperarJobsAbandonados({
+    ...entrada,
+    limiteMs: entrada.limiteMs != null ? entrada.limiteMs : 0
+  }, opts);
+  // limiteMs=0 → processando_em <= agora (todos PROCESSANDO com timestamp)
+  return {
+    ...out,
