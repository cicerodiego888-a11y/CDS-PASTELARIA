+/**
+ * Executa fn sob BEGIN IMMEDIATE.
+ * Se a conexão já estiver em transação, executa fn nela (sem nested BEGIN).
+ */
+async function comTransacaoImediata(db, fn) {
+  let ownsTx = false;
+  try {
+    await dbExec(db, 'BEGIN IMMEDIATE');
+    ownsTx = true;
+  } catch (err) {
+    const msg = String(err && err.message ? err.message : err);
+    if (!/within a transaction/i.test(msg)) throw err;
+  }
+  try {
+    const out = await fn();
+    if (ownsTx) await dbExec(db, 'COMMIT');
+    return out;
+  } catch (err) {
+    if (ownsTx) {
+      try { await dbExec(db, 'ROLLBACK'); } catch (_e) { /* ignore */ }
+    }
+    throw err;
+  }
 }
 
