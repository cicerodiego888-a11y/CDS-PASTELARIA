diff --git a/backend/services/cozinha/CozinhaImpressaoElectronProducao.js b/backend/services/cozinha/CozinhaImpressaoElectronProducao.js
new file mode 100644
--- a/backend/services/cozinha/CozinhaImpressaoElectronProducao.js
+++ b/backend/services/cozinha/CozinhaImpressaoElectronProducao.js
@@ -0,0 +1,160 @@
+/**
+ * Integração de produção Worker ↔ Electron — Sprint 06 Bloco E (E-03).
+ *
+ * Instancia o adapter real (webContents.getPrintersAsync / print) e injeta
+ * o driver ELECTRON no Worker. FAKE permanece isolado para testes.
+ *
+ * Impressão física continua desabilitada por padrão.
+ */
+'use strict';
+
+const { criarFakeDriver } = require('./cozinhaImpressaoDriver');
+const { criarElectronDriver } = require('./cozinhaImpressaoElectronDriver');
+const { isImpressaoFisicaAutorizada } = require('./cozinhaImpressaoElectronBridge');
+const { erroImpressao } = require('./cozinhaImpressaoContratos');
+
+/**
+ * Adapter Electron real (processo main). Não usa IPC do renderer para print.
+ * @param {object} deps
+ * @param {function(): object|null} deps.obterWebContents — retorna webContents vivo
+ * @param {function(object): Promise<object>} [deps.criarJanelaImpressao] — opcional
+ */
+function criarAdapterElectronProducao(deps = {}) {
+  if (typeof deps.obterWebContents !== 'function') {
+    throw erroImpressao(
+      'Adapter de produção exige obterWebContents().',
+      500,
+      'IMPRESSAO_ADAPTER_PRODUCAO_INVALIDO'
+    );
+  }
+
+  return {
+    tipo: 'electron-producao',
+    async getPrinters() {
+      const wc = deps.obterWebContents();
+      if (!wc || (typeof wc.isDestroyed === 'function' && wc.isDestroyed())) {
+        return [];
+      }
+      if (typeof wc.getPrintersAsync !== 'function') {
+        throw new Error('webContents.getPrintersAsync indisponível');
+      }
+      const lista = await wc.getPrintersAsync();
+      return (lista || []).map((imp) => ({
+        name: imp.name,
+        displayName: imp.displayName || imp.name,
+        description: imp.description,
+        status: imp.status,
+        isDefault: imp.isDefault === true
+      }));
+    },
+    async print({ deviceName, texto, silent }) {
+      // Print em janela oculta dedicada (mesmo processo main — sem renderer genérico).
+      let win = null;
+      let wc = null;
+      if (typeof deps.criarJanelaImpressao === 'function') {
+        win = await deps.criarJanelaImpressao();
+        wc = win && win.webContents;
+      } else {
+        wc = deps.obterWebContents();
+      }
+      if (!wc || typeof wc.print !== 'function') {
+        throw new Error('webContents.print indisponível no adapter de produção');
+      }
+
+      const html = `<!doctype html><html><head><meta charset="utf-8">
+<style>
+  @page { margin: 0; }
+  body { margin: 0; font-family: monospace; white-space: pre-wrap; font-size: 12px; }
+</style></head><body>${String(texto)
+  .replace(/&/g, '&amp;')
+  .replace(/</g, '&lt;')
+  .replace(/>/g, '&gt;')}</body></html>`;
+
+      if (typeof wc.loadURL === 'function') {
+        await wc.loadURL(`data:text/html;charset=utf-8,${encodeURIComponent(html)}`);
+      }
+
+      return new Promise((resolve, reject) => {
+        wc.print(
+          {
+            silent: silent !== false,
+            deviceName: deviceName || undefined,
+            printBackground: false
+          },
+          (success, failureReason) => {
+            if (win && typeof win.destroy === 'function') {
+              try { win.destroy(); } catch (_e) { /* ignore */ }
+            }
+            if (!success) {
+              reject(new Error(failureReason || 'webContents.print falhou'));
+              return;
+            }
+            resolve({ token: `electron-prod:${deviceName}:${Date.now()}` });
+          }
+        );
+      });
+    }
+  };
+}
+
+/**
+ * Driver ELECTRON de produção injetável no Worker.
+ */
+function criarDriverElectronProducao(opts = {}) {
+  const adapter = opts.adapter || criarAdapterElectronProducao(opts);
+  if (adapter.tipo !== 'electron-producao' && opts.exigirTipoProducao !== false) {
+    // Permite injeção de adapter produção-compatível em testes de ligação.
+    if (!opts.permitirAdapterCompat) {
+      throw erroImpressao(
+        'Driver de produção exige adapter electron-producao.',
+        500,
+        'IMPRESSAO_ADAPTER_PRODUCAO_INVALIDO'
+      );
+    }
+  }
+  return criarElectronDriver({
+    adapter,
+    autorizarSpoolerReal: opts.autorizarSpoolerReal === true,
+    timeoutMs: opts.timeoutMs,
+    deviceName: opts.deviceName,
+    producao: true
+  });
+}
+
+/**
+ * Fábrica usada pelo bootstrap do Worker em produção.
+ * @param {'FAKE'|'ELECTRON'} [modo]
+ */
+function criarDriverParaWorker(modo = 'FAKE', opts = {}) {
+  const m = String(modo || 'FAKE').toUpperCase();
+  if (m === 'ELECTRON') {
+    return criarDriverElectronProducao(opts);
+  }
+  return criarFakeDriver(opts.fake || { modo: 'sucesso' });
+}
+
+/**
+ * Evidência de ligação produção: retorna metadados do driver injetado.
+ */
+function descreverIntegracaoProducao(driver) {
+  if (!driver) {
+    return { ok: false, motivo: 'driver ausente' };
+  }
+  return {
+    ok: driver.nome === 'ELECTRON' && driver.isProducao === true,
+    driver: driver.nome,
+    producao: driver.isProducao === true,
+    adapter_tipo: driver.adapter && driver.adapter.tipo,
+    spooler_real_habilitado: typeof driver.spoolerRealHabilitado === 'boolean'
+      ? driver.spoolerRealHabilitado
+      : isImpressaoFisicaAutorizada({ autorizarSpoolerReal: !!driver.autorizarSpoolerReal }),
+    impressao_fisica: driver.impressaoFisica === true
+  };
+}
+
+module.exports = {
+  criarAdapterElectronProducao,
+  criarDriverElectronProducao,
+  criarDriverParaWorker,
+  descreverIntegracaoProducao
+};
diff --git a/backend/services/cozinha/CozinhaImpressaoWorkerService.js b/backend/services/cozinha/CozinhaImpressaoWorkerService.js
--- a/backend/services/cozinha/CozinhaImpressaoWorkerService.js
+++ b/backend/services/cozinha/CozinhaImpressaoWorkerService.js
@@ -1,2 +1,391 @@
+/**
+ * Worker de impressão — Sprint 06 Bloco D.
+ * Claim atômico, FAKE driver, falhas / RESULTADO_INCERTO, sem print físico / Electron / Bloco E.
+ *
+ * Política conservadora: dúvida → RESULTADO_INCERTO; sem reenvio automático.
+ * PROCESSANDO abandonado NÃO volta para PENDENTE.
+ */
+'use strict';
+
+const {
+  erroImpressao,
+  parsePositiveInteger,
+  ESTADOS_FILA
+} = require('./cozinhaImpressaoContratos');
+const { exigirUnidadeOperacional } = require('./cozinhaUnidadeOperacional');
+const { RESULTADOS_DRIVER, assertResultadoDriver, criarFakeDriver } = require('./cozinhaImpressaoDriver');
+const FilaService = require('./CozinhaImpressaoFilaService');
+
+const ABANDONO_PADRAO_MS = 60 * 1000;
+
+function dbAll(db, sql, params = []) {
+  return new Promise((resolve, reject) => {
+    db.all(sql, params, (err, rows) => (err ? reject(err) : resolve(rows || [])));
+  });
+}
+
+function dbGet(db, sql, params = []) {
+  return new Promise((resolve, reject) => {
+    db.get(sql, params, (err, row) => (err ? reject(err) : resolve(row || null)));
+  });
+}
+
+function dbRun(db, sql, params = []) {
+  return new Promise((resolve, reject) => {
+    db.run(sql, params, function cb(err) {
+      if (err) reject(err);
+      else resolve(this);
+    });
+  });
+}
+
+function dbExec(db, sql) {
+  return new Promise((resolve, reject) => {
+    db.exec(sql, (err) => (err ? reject(err) : resolve()));
+  });
+}
+
+function agoraIso() {
+  return new Date().toISOString();
+}
+
+/**
+ * Executa fn sob BEGIN IMMEDIATE obrigatório.
+ * Não adere a transação externa desconhecida: se a conexão já estiver
+ * em TX, propaga erro (COMMIT/ROLLBACK só da TX iniciada aqui).
+ */
+async function comTransacaoImediata(db, fn) {
+  try {
+    await dbExec(db, 'BEGIN IMMEDIATE');
+  } catch (err) {
+    const msg = String(err && err.message ? err.message : err);
+    if (/within a transaction/i.test(msg)) {
+      throw erroImpressao(
+        'Claim exige BEGIN IMMEDIATE próprio; conexão já está em transação externa.',
+        409,
+        'IMPRESSAO_CLAIM_TX_EXTERNA',
+        { detalhes: { causa: msg } }
+      );
+    }
+    throw err;
+  }
+
+  try {
+    const out = await fn();
+    await dbExec(db, 'COMMIT');
+    return out;
+  } catch (err) {
+    try { await dbExec(db, 'ROLLBACK'); } catch (_e) { /* ignore */ }
+    throw err;
+  }
+}
+
+function exigirEmpresa(empresaId) {
+  const id = parsePositiveInteger(empresaId);
+  if (!id) {
+    throw erroImpressao('empresa_id obrigatório.', 400, 'EMPRESA_OBRIGATORIA');
+  }
+  return id;
+}
+
+function normalizarWorkerId(raw) {
+  const id = String(raw == null ? '' : raw).trim();
+  if (!id) {
+    throw erroImpressao('worker_id obrigatório.', 400, 'IMPRESSAO_WORKER_ID_OBRIGATORIO');
+  }
+  if (id.length > 128) {
+    throw erroImpressao('worker_id excede o tamanho máximo.', 400, 'IMPRESSAO_WORKER_ID_INVALIDO');
+  }
+  return id;
+}
+
+function estadoFinalDeResultadoDriver(resultado) {
+  if (resultado === RESULTADOS_DRIVER.ACEITA) return ESTADOS_FILA.ACEITA_PELO_SPOOLER;
+  if (resultado === RESULTADOS_DRIVER.FALHA) return ESTADOS_FILA.FALHA;
+  // E-01: simulação/dry-run libera o claim sem declarar ACEITA_PELO_SPOOLER.
+  if (resultado === RESULTADOS_DRIVER.SIMULADO) return ESTADOS_FILA.PENDENTE;
+  return ESTADOS_FILA.RESULTADO_INCERTO;
+}
+
+/**
+ * Claim atômico PENDENTE → PROCESSANDO.
+ *
+ * Fluxo inequívoco (por chamada):
+ * 1) BEGIN IMMEDIATE
+ * 2) SELECT candidato (id exato)
+ * 3) UPDATE ... WHERE id=? AND estado='PENDENTE' (changes deve ser 1)
+ * 4) SELECT * WHERE id=? (o mesmo id)
+ * 5) COMMIT
+ *
+ * Não recupera o job por worker_id/timestamp/MAX(id).
+ */
+async function reivindicarProximoJob(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  const workerId = normalizarWorkerId(
+    entrada.workerId != null ? entrada.workerId : entrada.worker_id
+  );
+  const estacaoId = parsePositiveInteger(
+    entrada.estacaoImpressaoId != null
+      ? entrada.estacaoImpressaoId
+      : (entrada.estacao_impressao_id != null ? entrada.estacao_impressao_id : entrada.estacaoId)
+  );
+
+  return comTransacaoImediata(db, async () => {
+    let sqlCand = `
+      SELECT id
+      FROM cozinha_impressao_fila
+      WHERE empresa_id = ?
+        AND unidade_id = ?
+        AND estado = ?
+        AND tentativas < max_tentativas
+    `;
+    const paramsCand = [empresaId, unidadeId, ESTADOS_FILA.PENDENTE];
+    if (estacaoId) {
+      sqlCand += ' AND estacao_impressao_id = ?';
+      paramsCand.push(estacaoId);
+    }
+    sqlCand += ' ORDER BY created_at ASC, id ASC LIMIT 1';
+
+    const cand = await dbGet(db, sqlCand, paramsCand);
+    if (!cand || !cand.id) {
+      return { success: true, reivindicado: false, job: null, impressao_fisica: false };
+    }
+
+    const jobId = Number(cand.id);
+    const agora = agoraIso();
+    const upd = await dbRun(db, `
+      UPDATE cozinha_impressao_fila
+      SET estado = ?,
+          worker_id = ?,
+          processando_em = ?,
+          tentativas = tentativas + 1,
+          updated_at = ?,
+          ultimo_erro = NULL
+      WHERE id = ?
+        AND empresa_id = ?
+        AND unidade_id = ?
+        AND estado = ?
+    `, [
+      ESTADOS_FILA.PROCESSANDO,
+      workerId,
+      agora,
+      agora,
+      jobId,
+      empresaId,
+      unidadeId,
+      ESTADOS_FILA.PENDENTE
+    ]);
+
+    if (!upd || upd.changes !== 1) {
+      // Outro worker conquistou o mesmo id entre SELECT e UPDATE.
+      return { success: true, reivindicado: false, job: null, impressao_fisica: false };
+    }
+
+    const row = await dbGet(db, `
+      SELECT *
+      FROM cozinha_impressao_fila
+      WHERE id = ?
+        AND empresa_id = ?
+        AND unidade_id = ?
+    `, [jobId, empresaId, unidadeId]);
+
+    if (!row || row.estado !== ESTADOS_FILA.PROCESSANDO || Number(row.id) !== jobId) {
+      throw erroImpressao(
+        'Claim inconsistente: job reivindicado não encontrado pelo id.',
+        500,
+        'IMPRESSAO_CLAIM_INCONSISTENTE',
+        { detalhes: { job_id: jobId } }
+      );
+    }
+
+    return {
+      success: true,
+      reivindicado: true,
+      job: FilaService.mapearJob(row, { incluirSnapshot: true }),
+      impressao_fisica: false
+    };
+  });
+}
+
+/**
+ * Jobs PROCESSANDO abandonados → RESULTADO_INCERTO (nunca voltam a PENDENTE).
+ */
+async function recuperarJobsAbandonados(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  const rawLim = entrada.limiteMs != null ? entrada.limiteMs : entrada.abandono_ms;
+  const limiteMs = Number(rawLim);
+  // limiteMs === 0 → todos PROCESSANDO (ex.: reinício do worker); omitido → padrão.
+  const lim = rawLim == null || rawLim === ''
+    ? ABANDONO_PADRAO_MS
+    : (Number.isFinite(limiteMs) && limiteMs >= 0 ? limiteMs : ABANDONO_PADRAO_MS);
+  const agora = Date.now();
+  const limiteIso = new Date(agora - lim).toISOString();
+
+  const rows = await dbAll(db, `
+    SELECT id, processando_em, worker_id
+    FROM cozinha_impressao_fila
+    WHERE empresa_id = ?
+      AND unidade_id = ?
+      AND estado = ?
+      AND (
+        processando_em IS NULL
+        OR processando_em <= ?
+      )
+  `, [empresaId, unidadeId, ESTADOS_FILA.PROCESSANDO, limiteIso]);
+
+  const marcados = [];
+  for (const row of rows) {
+    const agoraUpd = agoraIso();
+    const msg = `Worker abandonado/timeout — resultado indeterminável (worker_id=${row.worker_id || '?'})`;
+    const upd = await dbRun(db, `
+      UPDATE cozinha_impressao_fila
+      SET estado = ?,
+          ultimo_erro = ?,
+          updated_at = ?
+      WHERE id = ?
+        AND empresa_id = ?
+        AND unidade_id = ?
+        AND estado = ?
+    `, [
+      ESTADOS_FILA.RESULTADO_INCERTO,
+      msg,
+      agoraUpd,
+      row.id,
+      empresaId,
+      unidadeId,
+      ESTADOS_FILA.PROCESSANDO
+    ]);
+    if (upd && upd.changes === 1) {
+      marcados.push(row.id);
+    }
+  }
+
+  return {
+    success: true,
+    recuperados: marcados.length,
+    job_ids: marcados,
+    novo_estado: ESTADOS_FILA.RESULTADO_INCERTO,
+    impressao_fisica: false
+  };
+}
+
+/**
+ * Aplica resultado do driver apenas se o job ainda está PROCESSANDO pelo mesmo worker.
+ */
+async function registrarResultado(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  const jobId = parsePositiveInteger(entrada.jobId != null ? entrada.jobId : entrada.id);
+  const workerId = normalizarWorkerId(
+    entrada.workerId != null ? entrada.workerId : entrada.worker_id
+  );
+  if (!jobId) {
+    throw erroImpressao('job id obrigatório.', 400, 'IMPRESSAO_JOB_ID_OBRIGATORIO');
+  }
+
+  const driverOut = assertResultadoDriver({
+    resultado: entrada.resultado,
+    spooler_job_token: entrada.spooler_job_token != null
+      ? entrada.spooler_job_token
+      : entrada.spoolerJobToken,
+    erro: entrada.erro != null ? entrada.erro : entrada.ultimo_erro,
+    impressao_fisica: false,
+    driver: entrada.driver || 'FAKE'
+  });
+
+  const estadoFinal = estadoFinalDeResultadoDriver(driverOut.resultado);
+  const agora = agoraIso();
+  const ehSimulado = driverOut.resultado === RESULTADOS_DRIVER.SIMULADO;
+
+  const upd = await dbRun(db, `
+    UPDATE cozinha_impressao_fila
