# DIFF REAL — Sprint 06 Bloco A (fundação e contratos de impressão)
# Schema permanece v3. Sem Blocos B–E.
diff --git a/backend/services/cozinha/cozinhaImpressaoContratos.js b/backend/services/cozinha/cozinhaImpressaoContratos.js
index e69de29..9ffa257 100644
--- a/backend/services/cozinha/cozinhaImpressaoContratos.js
+++ b/backend/services/cozinha/cozinhaImpressaoContratos.js
@@ -0,0 +1,235 @@
+/**
+ * Contratos compartilhados — Impressão de Cozinha (Sprint 06 Bloco A).
+ * Independente de impressão comercial/fiscal (cupom, DANFE, TEF, MUV).
+ */
+'use strict';
+
+const LARGURAS_MM = Object.freeze([58, 80]);
+const LARGURA_PADRAO_MM = 80;
+
+const MODELOS_IMPRESSAO = Object.freeze({
+  INDIVIDUAL: 'INDIVIDUAL',
+  AGRUPADO: 'AGRUPADO'
+});
+
+/** Convenção D3: codigo_estacao alinhado a tipo_item (roteamento no Bloco C). */
+const CODIGOS_ESTACAO_TIPO = Object.freeze({
+  PASTEL: 'PASTEL',
+  BEBIDA: 'BEBIDA',
+  OUTRO: 'OUTRO'
+});
+
+const ESTADOS_FILA = Object.freeze({
+  PENDENTE: 'PENDENTE',
+  PROCESSANDO: 'PROCESSANDO',
+  RESULTADO_INCERTO: 'RESULTADO_INCERTO',
+  ACEITA_PELO_SPOOLER: 'ACEITA_PELO_SPOOLER',
+  FALHA: 'FALHA',
+  CANCELADA: 'CANCELADA'
+});
+
+function erroImpressao(mensagem, statusCode, codigo, extras = {}) {
+  const err = new Error(mensagem);
+  err.statusCode = statusCode;
+  err.codigo = codigo;
+  Object.assign(err, extras);
+  return err;
+}
+
+function parsePositiveInteger(value) {
+  const num = Number(value);
+  return Number.isInteger(num) && num > 0 ? num : null;
+}
+
+function normalizarCodigoEstacao(raw) {
+  const codigo = String(raw == null ? '' : raw).trim().toUpperCase();
+  if (!codigo) {
+    throw erroImpressao(
+      'codigo_estacao obrigatório.',
+      400,
+      'ESTACAO_CODIGO_OBRIGATORIO'
+    );
+  }
+  if (codigo.length > 64) {
+    throw erroImpressao(
+      'codigo_estacao excede o tamanho máximo.',
+      400,
+      'ESTACAO_CODIGO_INVALIDO'
+    );
+  }
+  return codigo;
+}
+
+function normalizarLarguraMm(raw) {
+  const n = raw == null || raw === '' ? LARGURA_PADRAO_MM : Number(raw);
+  if (!LARGURAS_MM.includes(n)) {
+    throw erroImpressao(
+      'largura_mm deve ser 58 ou 80.',
+      400,
+      'ESTACAO_LARGURA_INVALIDA'
+    );
+  }
+  return n;
+}
+
+function normalizarVias(raw) {
+  const n = raw == null || raw === '' ? 1 : Number(raw);
+  if (!Number.isInteger(n) || n <= 0) {
+    throw erroImpressao(
+      'vias deve ser inteiro positivo.',
+      400,
+      'ESTACAO_VIAS_INVALIDAS'
+    );
+  }
+  return n;
+}
+
+function normalizarFlag01(raw, defaultValue = 1) {
+  if (raw == null || raw === '') return defaultValue ? 1 : 0;
+  const n = Number(raw);
+  if (n === 0 || n === 1) return n;
+  if (raw === true) return 1;
+  if (raw === false) return 0;
+  throw erroImpressao('Flag booleana inválida (use 0 ou 1).', 400, 'ESTACAO_FLAG_INVALIDA');
+}
+
+/**
+ * Monta o snapshot canônico do job (sem preços/fiscais).
+ * Bloco A: contrato + validação; enfileiramento real = Bloco B.
+ */
+function montarPayloadSnapshot(entrada = {}) {
+  const empresaId = parsePositiveInteger(entrada.empresa_id != null ? entrada.empresa_id : entrada.empresaId);
+  const unidadeId = parsePositiveInteger(entrada.unidade_id != null ? entrada.unidade_id : entrada.unidadeId);
+  const rodadaId = parsePositiveInteger(entrada.rodada_id != null ? entrada.rodada_id : entrada.rodadaId);
+
+  if (!empresaId) {
+    throw erroImpressao('empresa_id obrigatório no snapshot.', 400, 'SNAPSHOT_EMPRESA_OBRIGATORIA');
+  }
+  if (!unidadeId) {
+    throw erroImpressao('unidade_id obrigatório no snapshot.', 400, 'SNAPSHOT_UNIDADE_OBRIGATORIA');
+  }
+  if (!rodadaId) {
+    throw erroImpressao('rodada_id obrigatório no snapshot.', 400, 'SNAPSHOT_RODADA_OBRIGATORIA');
+  }
+
+  const modeloRaw = String(entrada.modelo || MODELOS_IMPRESSAO.AGRUPADO).trim().toUpperCase();
+  if (!MODELOS_IMPRESSAO[modeloRaw]) {
+    throw erroImpressao('modelo deve ser INDIVIDUAL ou AGRUPADO.', 400, 'SNAPSHOT_MODELO_INVALIDO');
+  }
+
+  const larguraMm = normalizarLarguraMm(entrada.largura_mm != null ? entrada.largura_mm : entrada.larguraMm);
+  const itensIn = Array.isArray(entrada.itens) ? entrada.itens : [];
+
+  const itens = itensIn.map((it, idx) => {
+    if (!it || typeof it !== 'object') {
+      throw erroImpressao(`Item de snapshot inválido no índice ${idx}.`, 400, 'SNAPSHOT_ITEM_INVALIDO');
+    }
+    const tipo = String(it.tipo_item || it.tipoItem || 'OUTRO').trim().toUpperCase();
+    if (!['PASTEL', 'BEBIDA', 'OUTRO'].includes(tipo)) {
+      throw erroImpressao(`tipo_item inválido no índice ${idx}.`, 400, 'SNAPSHOT_TIPO_ITEM_INVALIDO');
+    }
+    const ingredientes = Object.freeze(
+      (Array.isArray(it.ingredientes) ? it.ingredientes : []).map((ing) => Object.freeze({
+        nome: String(ing.nome || '').trim(),
+        qty: ing.qty != null ? String(ing.qty) : null,
+        selecionado: ing.selecionado == null ? true : !!ing.selecionado
+      }))
+    );
+
+    // Campos fiscais/preço são ignorados de propósito (não entram no snapshot).
+    return Object.freeze({
+      cozinha_item_id: parsePositiveInteger(it.cozinha_item_id != null ? it.cozinha_item_id : it.cozinhaItemId),
+      comanda_id: parsePositiveInteger(it.comanda_id != null ? it.comanda_id : it.comandaId),
+      tipo_item: tipo,
+      descricao: String(it.descricao || it.nome || '').trim(),
+      qty: it.qty != null ? String(it.qty) : (it.quantidade != null ? String(it.quantidade) : null),
+      observacao: it.observacao != null ? String(it.observacao) : null,
+      ingredientes
+    });
+  });
+
+  return Object.freeze({
+    empresa_id: empresaId,
+    unidade_id: unidadeId,
+    rodada_id: rodadaId,
+    sequencia_global: entrada.sequencia_global != null
+      ? Number(entrada.sequencia_global)
+      : (entrada.sequenciaGlobal != null ? Number(entrada.sequenciaGlobal) : null),
+    mesa_numero: entrada.mesa_numero != null
+      ? String(entrada.mesa_numero)
+      : (entrada.mesaNumero != null ? String(entrada.mesaNumero) : null),
+    atendimento_id: parsePositiveInteger(
+      entrada.atendimento_id != null ? entrada.atendimento_id : entrada.atendimentoId
+    ),
+    numero_rodada: entrada.numero_rodada != null
+      ? Number(entrada.numero_rodada)
+      : (entrada.numeroRodada != null ? Number(entrada.numeroRodada) : null),
+    enviada_em: entrada.enviada_em != null
+      ? String(entrada.enviada_em)
+      : (entrada.enviadaEm != null ? String(entrada.enviadaEm) : null),
+    modelo: modeloRaw,
+    largura_mm: larguraMm,
+    itens: Object.freeze(itens)
+  });
+}
+
+/**
+ * Serializa somente após revalidar/normalizar o contrato canônico.
+ * Descarta campos comerciais/fiscais; rejeita se restarem chaves proibidas.
+ */
+function serializarSnapshot(snapshot) {
+  const canonico = montarPayloadSnapshot(
+    snapshot && typeof snapshot === 'object' ? snapshot : {}
+  );
+  const proibidos = snapshotContemCamposProibidos(canonico);
+  if (proibidos.length) {
+    throw erroImpressao(
+      'Snapshot contém campos comerciais/fiscais proibidos.',
+      400,
+      'SNAPSHOT_CAMPO_PROIBIDO',
+      { detalhes: { campos: proibidos } }
+    );
+  }
+  return JSON.stringify(canonico);
+}
+
+function parseSnapshotJson(texto) {
+  if (texto == null || String(texto).trim() === '') {
+    throw erroImpressao('payload_snapshot vazio.', 400, 'SNAPSHOT_VAZIO');
+  }
+  let obj;
+  try {
+    obj = JSON.parse(String(texto));
+  } catch (_e) {
+    throw erroImpressao('payload_snapshot JSON inválido.', 400, 'SNAPSHOT_JSON_INVALIDO');
+  }
+  return montarPayloadSnapshot(obj);
+}
+
+function snapshotContemCamposProibidos(obj) {
+  const proibidos = [
+    'preco', 'preço', 'preco_unitario', 'preco_total', 'valor', 'valor_total',
+    'ncm', 'cfop', 'csosn', 'cpf', 'cnpj', 'danfe', 'nfc-e', 'nfce', 'nfe',
+    'tef', 'pagamento', 'forma_pagamento'
+  ];
+  const json = JSON.stringify(obj || {}).toLowerCase();
+  return proibidos.filter((p) => json.includes(`"${p}"`));
+}
+
+module.exports = {
+  LARGURAS_MM,
+  LARGURA_PADRAO_MM,
+  MODELOS_IMPRESSAO,
+  CODIGOS_ESTACAO_TIPO,
+  ESTADOS_FILA,
+  erroImpressao,
+  parsePositiveInteger,
+  normalizarCodigoEstacao,
+  normalizarLarguraMm,
+  normalizarVias,
+  normalizarFlag01,
+  montarPayloadSnapshot,
+  serializarSnapshot,
+  parseSnapshotJson,
+  snapshotContemCamposProibidos
+};

diff --git a/backend/services/cozinha/CozinhaImpressaoRenderer.js b/backend/services/cozinha/CozinhaImpressaoRenderer.js
index e69de29..f3caad3 100644
--- a/backend/services/cozinha/CozinhaImpressaoRenderer.js
+++ b/backend/services/cozinha/CozinhaImpressaoRenderer.js
@@ -0,0 +1,160 @@
+/**
+ * Renderer de snapshot — Impressão de Cozinha (Sprint 06 Bloco A).
+ * Gera TEXT para 58/80 mm. Não executa impressão física.
+ */
+'use strict';
+
+const {
+  montarPayloadSnapshot,
+  parseSnapshotJson,
+  normalizarLarguraMm,
+  LARGURA_PADRAO_MM,
+  erroImpressao
+} = require('./cozinhaImpressaoContratos');
+
+function larguraColunas(larguraMm) {
+  // Heurística de colunas ESC/POS / cupom térmico.
+  return larguraMm === 58 ? 32 : 48;
+}
+
+function linha(char, cols) {
+  return String(char || '-').repeat(cols);
+}
+
+function cortar(texto, cols) {
+  const s = String(texto == null ? '' : texto);
+  if (s.length <= cols) return s;
+  return s.slice(0, Math.max(0, cols - 1)) + '…';
+}
+
+function wrap(texto, cols) {
+  const s = String(texto == null ? '' : texto).trim();
+  if (!s) return [];
+  const out = [];
+  let rest = s;
+  while (rest.length > cols) {
+    out.push(rest.slice(0, cols));
+    rest = rest.slice(cols);
+  }
+  if (rest) out.push(rest);
+  return out;
+}
+
+/**
+ * @param {object|string} snapshotOuJson
+ * @param {{ largura_mm?: number }} [opts]
+ * @returns {{ largura_mm: number, colunas: number, texto: string, impressao_fisica: false }}
+ */
+function renderizarTexto(snapshotOuJson, opts = {}) {
+  const snapshot = typeof snapshotOuJson === 'string'
+    ? parseSnapshotJson(snapshotOuJson)
+    : montarPayloadSnapshot(snapshotOuJson);
+
+  const larguraMm = normalizarLarguraMm(
+    opts.largura_mm != null ? opts.largura_mm : (snapshot.largura_mm || LARGURA_PADRAO_MM)
+  );
+  const cols = larguraColunas(larguraMm);
+  const linhas = [];
+
+  linhas.push(cortar('COZINHA', cols));
+  linhas.push(linha('=', cols));
+  if (snapshot.mesa_numero != null) {
+    linhas.push(cortar(`Mesa: ${snapshot.mesa_numero}`, cols));
+  }
+  if (snapshot.sequencia_global != null && Number.isFinite(snapshot.sequencia_global)) {
+    linhas.push(cortar(`Seq: ${snapshot.sequencia_global}`, cols));
+  }
+  if (snapshot.numero_rodada != null && Number.isFinite(snapshot.numero_rodada)) {
+    linhas.push(cortar(`Rodada: ${snapshot.numero_rodada}`, cols));
+  }
+  if (snapshot.enviada_em) {
+    linhas.push(cortar(`Envio: ${snapshot.enviada_em}`, cols));
+  }
+  linhas.push(cortar(`Modelo: ${snapshot.modelo}`, cols));
+  linhas.push(linha('-', cols));
+
+  if (!snapshot.itens.length) {
+    linhas.push(cortar('(sem itens)', cols));
+  }
+
+  for (const item of snapshot.itens) {
+    const qty = item.qty != null ? item.qty : '';
+    const cab = [qty, item.tipo_item, item.descricao].filter(Boolean).join(' ');
+    for (const w of wrap(cab, cols)) linhas.push(w);
+    if (item.comanda_id) {
+      linhas.push(cortar(`  Comanda #${item.comanda_id}`, cols));
+    }
+    if (item.observacao) {
+      for (const w of wrap(`  Obs: ${item.observacao}`, cols)) linhas.push(w);
+    }
+    for (const ing of item.ingredientes || []) {
+      if (!ing.selecionado) continue;
+      const ingTxt = ['  +', ing.nome, ing.qty].filter(Boolean).join(' ');
+      for (const w of wrap(ingTxt, cols)) linhas.push(w);
+    }
+    linhas.push(linha('-', cols));
+  }
+
+  linhas.push(cortar('*** FIM ***', cols));
+
+  return Object.freeze({
+    largura_mm: larguraMm,
+    colunas: cols,
+    texto: linhas.join('\n'),
+    impressao_fisica: false
+  });
+}
+
+/**
+ * Preview de teste de estação (D6) — sem fila, sem print físico.
+ */
+function renderizarTesteEstacao(estacao = {}) {
+  const larguraMm = normalizarLarguraMm(estacao.largura_mm);
+  const codigo = String(estacao.codigo_estacao || 'TESTE').trim().toUpperCase() || 'TESTE';
+  const snapshot = montarPayloadSnapshot({
+    empresa_id: estacao.empresa_id || 1,
+    unidade_id: estacao.unidade_id || 1,
+    rodada_id: estacao.rodada_id || 1,
+    sequencia_global: 0,
+    mesa_numero: 'TESTE',
+    numero_rodada: 0,
+    enviada_em: new Date().toISOString(),
+    modelo: 'AGRUPADO',
+    largura_mm: larguraMm,
+    itens: [{
+      cozinha_item_id: 1,
+      comanda_id: 1,
+      tipo_item: 'OUTRO',
+      descricao: `Teste estacao ${codigo}`,
+      qty: '1.000',
+      observacao: 'Sem impressao fisica (Bloco A)',
+      ingredientes: []
+    }]
+  });
+  const render = renderizarTexto(snapshot, { largura_mm: larguraMm });
+  return Object.freeze({
+    ...render,
+    codigo_estacao: codigo,
+    device_name: estacao.device_name != null ? String(estacao.device_name) : null,
+    modo: 'TESTE_ESTACAO',
+    impressao_fisica: false
+  });
+}
+
+function assertSemImpressaoFisica(resultado) {
+  if (!resultado || resultado.impressao_fisica !== false) {
+    throw erroImpressao(
+      'Renderer Bloco A não pode marcar impressao_fisica=true.',
+      500,
+      'IMPRESSAO_BLOCO_A_VIOLACAO'
+    );
+  }
+  return resultado;
+}
+
+module.exports = {
+  renderizarTexto,
+  renderizarTesteEstacao,
+  assertSemImpressaoFisica,
+  larguraColunas
+};

diff --git a/backend/services/cozinha/CozinhaImpressaoEstacaoService.js b/backend/services/cozinha/CozinhaImpressaoEstacaoService.js
index e69de29..2bd43b1 100644
--- a/backend/services/cozinha/CozinhaImpressaoEstacaoService.js
+++ b/backend/services/cozinha/CozinhaImpressaoEstacaoService.js
@@ -0,0 +1,286 @@
+/**
+ * CRUD de estações de impressão — Sprint 06 Bloco A.
+ * Isolamento por empresa + unidade. Sem impressão física.
+ */
+'use strict';
+
+const {
+  erroImpressao,
+  parsePositiveInteger,
+  normalizarCodigoEstacao,
+  normalizarLarguraMm,
+  normalizarVias,
+  normalizarFlag01
+} = require('./cozinhaImpressaoContratos');
+const { exigirUnidadeOperacional } = require('./cozinhaUnidadeOperacional');
+const { renderizarTesteEstacao } = require('./CozinhaImpressaoRenderer');
+
+function dbAll(db, sql, params = []) {
+  return new Promise((resolve, reject) => {
+    db.all(sql, params, (err, rows) => (err ? reject(err) : resolve(rows || [])));
+  });
+}
+
+function dbGet(db, sql, params = []) {
+  return new Promise((resolve, reject) => {
+    db.get(sql, params, (err, row) => (err ? reject(err) : resolve(row || null)));
+  });
+}
+
+function dbRun(db, sql, params = []) {
+  return new Promise((resolve, reject) => {
+    db.run(sql, params, function cb(err) {
+      if (err) return reject(err);
+      resolve(this);
+    });
+  });
+}
+
+function exigirEmpresa(empresaId) {
+  const id = parsePositiveInteger(empresaId);
+  if (!id) {
+    throw erroImpressao('empresa_id obrigatório.', 400, 'EMPRESA_CONTEXT_REQUIRED');
+  }
+  return id;
+}
+
+function mapearEstacao(row) {
+  if (!row) return null;
+  return {
+    id: row.id,
+    empresa_id: row.empresa_id,
+    unidade_id: row.unidade_id,
+    codigo_estacao: row.codigo_estacao,
+    device_name: row.device_name,
+    largura_mm: row.largura_mm,
+    vias: row.vias,
+    modelo_individual: Number(row.modelo_individual) === 1,
+    modelo_agrupado: Number(row.modelo_agrupado) === 1,
+    ativo: Number(row.ativo) === 1,
+    created_at: row.created_at,
+    updated_at: row.updated_at
+  };
+}
+
+async function exigirUnidadeDaEmpresa(db, empresaId, unidadeId) {
+  const unidade = await dbGet(db, `
+    SELECT id, empresa_id, codigo, ativo
+    FROM cozinha_unidades
+    WHERE id = ? AND empresa_id = ?
+  `, [unidadeId, empresaId]);
+  if (!unidade) {
+    throw erroImpressao(
+      'Unidade não pertence à empresa autenticada.',
+      403,
+      'UNIDADE_EMPRESA_ISOLAMENTO'
+    );
+  }
+  return unidade;
+}
+
+async function listarEstacoes(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  await exigirUnidadeDaEmpresa(db, empresaId, unidadeId);
+
+  const apenasAtivas = entrada.apenas_ativas === true || entrada.apenasAtivas === true;
+  const rows = await dbAll(db, `
+    SELECT *
+    FROM cozinha_estacoes_impressao
+    WHERE empresa_id = ? AND unidade_id = ?
+      ${apenasAtivas ? 'AND ativo = 1' : ''}
+    ORDER BY codigo_estacao COLLATE NOCASE ASC, id ASC
+  `, [empresaId, unidadeId]);
+
+  return {
+    success: true,
+    empresa_id: empresaId,
+    unidade_id: unidadeId,
+    estacoes: rows.map(mapearEstacao)
+  };
+}
+
+async function obterEstacao(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  const id = parsePositiveInteger(entrada.id != null ? entrada.id : entrada.estacaoId);
+  if (!id) throw erroImpressao('Estação inválida.', 400, 'ESTACAO_ID_INVALIDO');
+
+  await exigirUnidadeDaEmpresa(db, empresaId, unidadeId);
+
+  const row = await dbGet(db, `
+    SELECT *
+    FROM cozinha_estacoes_impressao
+    WHERE id = ? AND empresa_id = ? AND unidade_id = ?
+  `, [id, empresaId, unidadeId]);
+
+  if (!row) {
+    throw erroImpressao('Estação não encontrada.', 404, 'ESTACAO_NAO_ENCONTRADA');
+  }
+  return { success: true, estacao: mapearEstacao(row) };
+}
+
+async function criarEstacao(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  await exigirUnidadeDaEmpresa(db, empresaId, unidadeId);
+
+  const codigo = normalizarCodigoEstacao(
+    entrada.codigo_estacao != null ? entrada.codigo_estacao : entrada.codigoEstacao
+  );
+  const deviceName = entrada.device_name != null
+    ? String(entrada.device_name).trim() || null
+    : (entrada.deviceName != null ? String(entrada.deviceName).trim() || null : null);
+  const larguraMm = normalizarLarguraMm(
+    entrada.largura_mm != null ? entrada.largura_mm : entrada.larguraMm
+  );
+  const vias = normalizarVias(entrada.vias);
+  const modeloIndividual = normalizarFlag01(
+    entrada.modelo_individual != null ? entrada.modelo_individual : entrada.modeloIndividual,
+    1
+  );
+  const modeloAgrupado = normalizarFlag01(
+    entrada.modelo_agrupado != null ? entrada.modelo_agrupado : entrada.modeloAgrupado,
+    1
+  );
+  const ativo = normalizarFlag01(entrada.ativo, 1);
+
+  try {
+    const result = await dbRun(db, `
+      INSERT INTO cozinha_estacoes_impressao (
+        empresa_id, unidade_id, codigo_estacao, device_name,
+        largura_mm, vias, modelo_individual, modelo_agrupado, ativo, updated_at
+      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, CURRENT_TIMESTAMP)
+    `, [
+      empresaId, unidadeId, codigo, deviceName,
+      larguraMm, vias, modeloIndividual, modeloAgrupado, ativo
+    ]);
+    return obterEstacao({ db, empresaId, unidadeId, id: result.lastID }, { db });
+  } catch (err) {
+    if (/UNIQUE|unique/i.test(String(err && err.message))) {
+      throw erroImpressao(
+        'Já existe estação com este codigo_estacao nesta unidade.',
+        409,
+        'ESTACAO_CODIGO_DUPLICADO'
+      );
+    }
+    throw err;
+  }
+}
+
+async function atualizarEstacao(entrada = {}, opts = {}) {
+  const db = opts.db || entrada.db;
+  if (!db) throw erroImpressao('Banco indisponível.', 500, 'DB_INDISPONIVEL');
+
+  const empresaId = exigirEmpresa(entrada.empresaId != null ? entrada.empresaId : entrada.empresa_id);
+  const unidadeId = exigirUnidadeOperacional(
+    entrada.unidadeId != null ? entrada.unidadeId : entrada.unidade_id
+  );
+  const id = parsePositiveInteger(entrada.id != null ? entrada.id : entrada.estacaoId);
+  if (!id) throw erroImpressao('Estação inválida.', 400, 'ESTACAO_ID_INVALIDO');
+
+  const atual = await obterEstacao({ db, empresaId, unidadeId, id }, { db });
+  const body = entrada.dados && typeof entrada.dados === 'object' ? entrada.dados : entrada;
+
+  const codigo = body.codigo_estacao != null || body.codigoEstacao != null
+    ? normalizarCodigoEstacao(body.codigo_estacao != null ? body.codigo_estacao : body.codigoEstacao)
+    : atual.estacao.codigo_estacao;
+
+  const deviceName = body.device_name !== undefined
+    ? (body.device_name == null ? null : String(body.device_name).trim() || null)
+    : (body.deviceName !== undefined
+      ? (body.deviceName == null ? null : String(body.deviceName).trim() || null)
+      : atual.estacao.device_name);
+
+  const larguraMm = body.largura_mm != null || body.larguraMm != null
+    ? normalizarLarguraMm(body.largura_mm != null ? body.largura_mm : body.larguraMm)
+    : atual.estacao.largura_mm;
+
+  const vias = body.vias != null
+    ? normalizarVias(body.vias)
+    : atual.estacao.vias;
+
+  const modeloIndividual = body.modelo_individual != null || body.modeloIndividual != null
+    ? normalizarFlag01(body.modelo_individual != null ? body.modelo_individual : body.modeloIndividual)
+    : (atual.estacao.modelo_individual ? 1 : 0);
+
+  const modeloAgrupado = body.modelo_agrupado != null || body.modeloAgrupado != null
+    ? normalizarFlag01(body.modelo_agrupado != null ? body.modelo_agrupado : body.modeloAgrupado)
+    : (atual.estacao.modelo_agrupado ? 1 : 0);
+
+  const ativo = body.ativo != null
+    ? normalizarFlag01(body.ativo)
+    : (atual.estacao.ativo ? 1 : 0);
+
+  try {
+    const result = await dbRun(db, `
+      UPDATE cozinha_estacoes_impressao
+      SET codigo_estacao = ?,
+          device_name = ?,
+          largura_mm = ?,
+          vias = ?,
+          modelo_individual = ?,
+          modelo_agrupado = ?,
+          ativo = ?,
+          updated_at = CURRENT_TIMESTAMP
+      WHERE id = ? AND empresa_id = ? AND unidade_id = ?
+    `, [
+      codigo, deviceName, larguraMm, vias,
+      modeloIndividual, modeloAgrupado, ativo,
+      id, empresaId, unidadeId
+    ]);
+    if (!result.changes) {
+      throw erroImpressao('Estação não encontrada.', 404, 'ESTACAO_NAO_ENCONTRADA');
+    }
+    return obterEstacao({ db, empresaId, unidadeId, id }, { db });
+  } catch (err) {
+    if (err.codigo) throw err;
+    if (/UNIQUE|unique/i.test(String(err && err.message))) {
+      throw erroImpressao(
+        'Já existe estação com este codigo_estacao nesta unidade.',
+        409,
+        'ESTACAO_CODIGO_DUPLICADO'
+      );
+    }
+    throw err;
+  }
+}
+
+/**
+ * Teste de contrato da estação (D6): render preview, sem fila e sem print físico.
+ */
+async function testarEstacao(entrada = {}, opts = {}) {
+  const obtido = await obterEstacao(entrada, opts);
+  const estacao = obtido.estacao;
+  const render = renderizarTesteEstacao(estacao);
+  return {
+    success: true,
+    estacao,
+    teste: render,
+    impressao_fisica: false
+  };
+}
+
+module.exports = {
+  listarEstacoes,
+  obterEstacao,
+  criarEstacao,
+  atualizarEstacao,
+  testarEstacao,
+  mapearEstacao
+};

