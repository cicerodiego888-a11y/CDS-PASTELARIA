+} = require('../../backend/services/cozinha/cozinhaImpressaoSessaoElectron');
+const { EventEmitter } = require('events');
+const {
+  IPC_CANAIS,
+  isImpressaoFisicaAutorizada,
+  validarRemetenteIpc,
+  rejeitarImpressaoGenericaPorIpc,
