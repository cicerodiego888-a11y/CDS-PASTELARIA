+    async getPrinters() {
+      return [{ name: 'Cozinha-Termica-80', isDefault: true }];
+    },
+    async print() {
+      prints.push({});
+      throw new Error('print físico proibido na auditoria complementar');
+    }
+  };
+}
+
+class MockWindow extends EventEmitter {
+  constructor() {
