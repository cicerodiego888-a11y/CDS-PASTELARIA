+}
+
+function obterWorkerImpressaoCozinhaInstalado() {
+  return _instancia;
+}
+
+function contarInstalacoesWorkerImpressao() {
+  return _instalacoes;
+}
+
+/** Somente testes. */
+function _resetBootstrapWorkerImpressaoParaTeste() {
+  if (_instancia && typeof _instancia.encerrar === 'function') {
+    _instancia.encerrar();
+  }
+  _instancia = null;
+  _instalacoes = 0;
+  _encerrado = false;
