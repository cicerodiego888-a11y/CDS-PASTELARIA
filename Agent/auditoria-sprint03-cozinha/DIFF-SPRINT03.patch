/**
 * Classificação operacional Cozinha — PASTEL | BEBIDA | OUTRO.
 * Domínio exclusivo da Cozinha (Sprint 03). Não altera Pedido/PDV/cadastros.
 *
 * Política (Opção A auditada + evidência de categoria para bebida):
 * 1) Valor explícito PASTEL|BEBIDA|OUTRO no snapshot → respeitar.
 * 2) INSUMO + comercializavel=1 + categoria refrigerante → BEBIDA.
 * 3) COMERCIAL + evidência de ficha/personalização → PASTEL.
 * 4) Demais → OUTRO.
 *
 * Nunca: COMERCIAL→PASTEL automático; INSUMO comercializável sem categoria→BEBIDA;
 * inferência por nome; ingredientes de ficha como item independente.
 */
'use strict';

const { CATEGORIAS_REFRIGERANTE, ehCategoriaRefrigerante } = require(
  '../pedido/PedidoRefrigeranteInsumoConsultaService'
);

const TIPOS_COZINHA = Object.freeze({
  PASTEL: 'PASTEL',
  BEBIDA: 'BEBIDA',
  OUTRO: 'OUTRO'
});

function textoUpper(v) {
  if (v == null || v === '') return '';
  return String(v).trim().toUpperCase();
}

function flagOn(v) {
  return v === true || v === 1 || v === '1' || Number(v) === 1;
}

function extrairExplicito(ctx = {}) {
  const candidatos = [
    ctx.tipo_item,
    ctx.tipo_cozinha,
    ctx.classificacao_operacional,
    ctx.classificacao_operacional_snapshot
  ];
  for (const bruto of candidatos) {
    const v = textoUpper(bruto);
    if (v === TIPOS_COZINHA.PASTEL || v === TIPOS_COZINHA.BEBIDA || v === TIPOS_COZINHA.OUTRO) {
      return v;
    }
  }
  return null;
}

function tipoOperacionalErp(ctx = {}) {
  const v = textoUpper(
    ctx.classificacao_operacional_snapshot
    || ctx.classificacao_operacional
    || ctx.tipo_operacional
  );
  if (v === 'INSUMO') return 'INSUMO';
  if (v === 'COMERCIAL' || v === 'PRODUTO' || v === 'PRODUTO_COMERCIAL') return 'COMERCIAL';
  return v || '';
}

function evidenciaPastel(ctx = {}) {
  if (flagOn(ctx.personalizacao_ingredientes_snapshot)) return true;
  if (flagOn(ctx.permite_personalizacao_ingredientes)) return true;
  if (ctx.utiliza_ficha_tecnica != null && flagOn(ctx.utiliza_ficha_tecnica)) return true;
  if (flagOn(ctx.tem_ficha_tecnica)) return true;
  if (Number(ctx.qtd_ingredientes_pedido || 0) > 0) return true;
  return false;
}

function evidenciaBebidaPorCategoria(ctx = {}) {
  const cat = ctx.categoria_nome || ctx.categoria || '';
  return ehCategoriaRefrigerante(cat);
}

/**
 * @param {object} ctx dados do item de pedido + produto/categoria/ficha
 * @returns {{ tipo: 'PASTEL'|'BEBIDA'|'OUTRO', motivo: string, confiavel: boolean }}
 */
function classificarItemCozinha(ctx = {}) {
  const explicito = extrairExplicito(ctx);
  if (explicito) {
    return { tipo: explicito, motivo: 'explicito_snapshot', confiavel: true };
  }

  const erp = tipoOperacionalErp(ctx);

  if (erp === 'INSUMO' && flagOn(ctx.comercializavel)) {
    if (evidenciaBebidaPorCategoria(ctx)) {
      return { tipo: TIPOS_COZINHA.BEBIDA, motivo: 'insumo_comercializavel_categoria_refrigerante', confiavel: true };
    }
    return {
      tipo: TIPOS_COZINHA.OUTRO,
      motivo: 'insumo_comercializavel_sem_categoria_bebida',
      confiavel: false
    };
  }

  if (erp === 'COMERCIAL' && evidenciaPastel(ctx)) {
    return { tipo: TIPOS_COZINHA.PASTEL, motivo: 'comercial_com_ficha_ou_personalizacao', confiavel: true };
  }

  if (erp === 'COMERCIAL') {
    return {
      tipo: TIPOS_COZINHA.OUTRO,
      motivo: 'comercial_sem_evidencia_pastel',
      confiavel: false
    };
  }

  return {
    tipo: TIPOS_COZINHA.OUTRO,
    motivo: 'sem_evidencia_operacional',
    confiavel: false
  };
}

/** Compatível com assinatura antiga do despacho (objeto item enriquecido). */
function classificarTipoItem(item) {
  return classificarItemCozinha(item || {}).tipo;
}

module.exports = {
  TIPOS_COZINHA,
  CATEGORIAS_REFRIGERANTE_COZINHA: CATEGORIAS_REFRIGERANTE,
  ehCategoriaRefrigerante,
  classificarItemCozinha,
  classificarTipoItem,
  evidenciaPastel,
  evidenciaBebidaPorCategoria
};


